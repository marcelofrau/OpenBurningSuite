<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OpenBurningSuite.Views.SettingsView"
             Background="#0C1622">

    <Grid ColumnDefinitions="220,*">

        <!-- Category sidebar -->
        <Border Grid.Column="0" Background="#0A1520"
                BorderBrush="#1E3450" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10,16,10,16" Spacing="2">
                    <TextBlock Text="⚙️ 设置"
                               Foreground="#5A7A9A" FontSize="10"
                               FontWeight="Bold" Margin="8,0,0,10"/>

                    <Button x:Name="TocGeneral" Content="🏠  常规"
                            Classes="NavBtn" Click="OnCategoryClick" Tag="SectionGeneral"/>
                    <Button x:Name="TocBurnDefaults" Content="🔥  刻录默认值"
                            Classes="NavBtn" Click="OnCategoryClick" Tag="SectionBurnDefaults"/>
                    <Button x:Name="TocReadDefaults" Content="💿  读取 / 复制默认值"
                            Classes="NavBtn" Click="OnCategoryClick" Tag="SectionReadDefaults"/>
                    <Button x:Name="TocVerification" Content="✅  校验"
                            Classes="NavBtn" Click="OnCategoryClick" Tag="SectionVerification"/>
                    <Button x:Name="TocFileSystem" Content="📂  文件系统默认值"
                            Classes="NavBtn" Click="OnCategoryClick" Tag="SectionFileSystem"/>
                    <Button x:Name="TocAudioCd" Content="🎵  音频 CD 默认值"
                            Classes="NavBtn" Click="OnCategoryClick" Tag="SectionAudioCd"/>
                    <Button x:Name="TocIoPerf" Content="⚡️  I/O 与性能"
                            Classes="NavBtn" Click="OnCategoryClick" Tag="SectionIoPerf"/>
                    <Button x:Name="TocPostActions" Content="🔔  操作后动作"
                            Classes="NavBtn" Click="OnCategoryClick" Tag="SectionPostActions"/>
                    <Button x:Name="TocLogging" Content="📋  日志与诊断"
                            Classes="NavBtn" Click="OnCategoryClick" Tag="SectionLogging"/>
                    <Button x:Name="TocPaths" Content="📁  路径与位置"
                            Classes="NavBtn" Click="OnCategoryClick" Tag="SectionPaths"/>
                    <Button x:Name="TocAdvanced" Content="🔧  高级与安全"
                            Classes="NavBtn" Click="OnCategoryClick" Tag="SectionAdvanced"/>
                    <Button x:Name="TocGaming" Content="🎮  游戏光盘默认值"
                            Classes="NavBtn" Click="OnCategoryClick" Tag="SectionGaming"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Main settings content area -->
        <ScrollViewer x:Name="ContentScroller" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,24,28,40" Spacing="20">

                <!-- Page header -->
                <StackPanel Spacing="4">
                    <TextBlock Text="⚙️  应用设置与首选项"
                               FontSize="20" FontWeight="SemiBold" Foreground="#E8F0FE"/>
                    <TextBlock Text="配置所有操作的默认行为、性能、路径和首选项。"
                               FontSize="12" Foreground="#5A7A9A" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Save / Reset bar -->
                <Border Classes="Card">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtSettingsStatus" Text="" Foreground="#5A7A9A" FontSize="11"/>
                        </StackPanel>
                        <Button x:Name="BtnSaveSettings" Grid.Column="1"
                                Content="💾  保存设置" Classes="PrimaryBtn"
                                Click="OnSaveClick"
                                ToolTip.Tip="将所有设置保存到磁盘"/>
                        <Button x:Name="BtnResetDefaults" Grid.Column="2"
                                Content="↩  恢复默认值" Classes="ActionBtn"
                                Margin="8,0,0,0" Click="OnResetClick"
                                ToolTip.Tip="将所有设置恢复为出厂默认值"/>
                        <Button x:Name="BtnOpenSettingsFile" Grid.Column="3"
                                Content="📄  打开设置文件" Classes="ActionBtn"
                                Margin="8,0,0,0" Click="OnOpenSettingsFileClick"
                                ToolTip.Tip="在系统编辑器中打开设置 JSON 文件"/>
                    </Grid>
                </Border>

                <!-- ============================================================ -->
                <!-- GENERAL -->
                <!-- ============================================================ -->
                <Border x:Name="SectionGeneral" Classes="Card">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="🏠" FontSize="16"/>
                            <TextBlock Text="常规" Classes="SectionHeader"/>
                        </StackPanel>
                        <TextBlock Text="常规应用行为和用户界面首选项。"
                                   Foreground="#5A7A9A" FontSize="11"/>

                        <CheckBox x:Name="ChkConfirmBeforeBurn"
                                  Content="开始刻录操作前显示确认对话框"
                                  Foreground="#E8F0FE"
                                  ToolTip.Tip="写入光盘前显示确认提示"/>
                        <CheckBox x:Name="ChkConfirmBeforeErase"
                                  Content="擦除光盘前显示确认对话框"
                                  Foreground="#E8F0FE"
                                  ToolTip.Tip="擦除可重写介质前显示确认提示"/>
                        <CheckBox x:Name="ChkMinimizeToTray"
                                  Content="最小化到系统托盘而不是任务栏"
                                  Foreground="#E8F0FE"
                                  ToolTip.Tip="最小化时将应用图标放入系统托盘"/>
                        <CheckBox x:Name="ChkPreventSleep"
                                  Content="刻录操作期间阻止系统睡眠/待机"
                                  Foreground="#E8F0FE"
                                  ToolTip.Tip="写入时保持系统唤醒以避免刻录失败"/>
                        <CheckBox x:Name="ChkPreventScreensaver"
                                  Content="刻录操作期间阻止屏幕保护程序"
                                  Foreground="#E8F0FE"
                                  ToolTip.Tip="刻录光盘时禁止启动屏幕保护程序"/>
                        <CheckBox x:Name="ChkCheckForUpdates"
                                  Content="启动时自动检查更新"
                                  Foreground="#E8F0FE"
                                  ToolTip.Tip="应用启动时检查新版本"/>
                        <CheckBox x:Name="ChkRememberWindowPos"
                                  Content="启动时记住并恢复窗口位置"
                                  Foreground="#E8F0FE"
                                  ToolTip.Tip="保存当前窗口大小和位置以供下次启动使用"/>
                        <CheckBox x:Name="ChkShowTooltips"
                                  Content="在界面控件上显示工具提示"
                                  Foreground="#E8F0FE"
                                  ToolTip.Tip="鼠标悬停在控件上时显示提示"/>
                    </StackPanel>
                </Border>

                <!-- ============================================================ -->
                <!-- BURN DEFAULTS -->
                <!-- ============================================================ -->
                <Border x:Name="SectionBurnDefaults" Classes="Card">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="🔥" FontSize="16"/>
                            <TextBlock Text="默认刻录 / 写入设置" Classes="SectionHeader"/>
                        </StackPanel>
                        <TextBlock Text="创建新刻录任务时应用的默认设置，可按任务覆盖。"
                                   Foreground="#5A7A9A" FontSize="11"/>

                        <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4,0,0">
                            <TextBlock Text="写入速度：" Classes="FieldLabel" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbDefaultWriteSpeed" Grid.Column="1"
                                      HorizontalAlignment="Stretch"
                                      ToolTip.Tip="刻录操作的默认写入速度"/>

                            <TextBlock Grid.Row="1" Text="写入模式：" Classes="FieldLabel" VerticalAlignment="Center" Margin="0,8,0,0"/>
                            <ComboBox x:Name="CmbDefaultWriteMode" Grid.Row="1" Grid.Column="1"
                                      HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                      ToolTip.Tip="默认写入模式（TAO、SAO/DAO）"/>

                            <TextBlock Grid.Row="2" Text="多区段：" Classes="FieldLabel" VerticalAlignment="Center" Margin="0,8,0,0"/>
                            <ComboBox x:Name="CmbDefaultMultiSession" Grid.Row="2" Grid.Column="1"
                                      HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                      ToolTip.Tip="默认多区段模式"/>
                        </Grid>

                        <CheckBox x:Name="ChkDefaultBUP"
                                  Content="启用缓存欠载保护"
                                  Foreground="#E8F0FE"
                                  ToolTip.Tip="防止可能导致光盘报废的缓存欠载"/>
                        <CheckBox x:Name="ChkDefaultVerifyAfterBurn"
                                  Content="刻录后校验数据"
                                  Foreground="#E8F0FE"
                                  ToolTip.Tip="自动校验写入的数据与源数据一致"/>
                        <CheckBox x:Name="ChkDefaultEjectAfterBurn"
                                  Content="刻录完成后弹出光盘"
                                  Foreground="#E8F0FE"
                                  ToolTip.Tip="刻录结束时自动弹出光盘托盘"/>
                        <CheckBox x:Name="ChkDefaultCloseDisc"
                                  Content="写入后关闭/封盘"
                                  Foreground="#E8F0FE"
                                  ToolTip.Tip="封盘以便光盘可在标准光驱中读取"/>
                        <CheckBox x:Name="ChkDefaultOverburn"
                                  Content="启用超刻（写入超过标称容量）"
                                  Foreground="#E8F0FE"
                                  ToolTip.Tip="允许写入超过光盘标称容量的数据（有风险）"/>
                        <CheckBox x:Name="ChkDefaultSimulate"
                                  Content="写入前模拟刻录（测试模式）"
                                  Foreground="#E8F0FE"
                                  ToolTip.Tip="执行模拟刻录进行测试，而不实际写入"/>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="默认份数：" Classes="FieldLabel" VerticalAlignment="Center"/>
                            <NumericUpDown x:Name="NudDefaultCopies" Minimum="1" Maximum="99"
                                           Value="1" Width="100"
                                           ToolTip.Tip="默认刻录的份数"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============================================================ -->
                <!-- READ / COPY DEFAULTS -->
                <!-- ============================================================ -->
                <Border x:Name="SectionReadDefaults" Classes="Card">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="💿" FontSize="16"/>
                            <TextBlock Text="默认读取 / 复制设置" Classes="SectionHeader"/>
                        </StackPanel>
                        <TextBlock Text="光盘读取和复制操作的默认设置。"
                                   Foreground="#5A7A9A" FontSize="11"/>

                        <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0,4,0,0">
                            <TextBlock Text="读取速度：" Classes="FieldLabel" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbDefaultReadSpeed" Grid.Column="1"
                                      HorizontalAlignment="Stretch"
                                      ToolTip.Tip="复制操作的默认读取速度"/>

                            <TextBlock Grid.Row="1" Text="输出格式：" Classes="FieldLabel" VerticalAlignment="Center" Margin="0,8,0,0"/>
                            <ComboBox x:Name="CmbDefaultOutputFormat" Grid.Row="1" Grid.Column="1"
                                      HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                      ToolTip.Tip="复制光盘时的默认镜像格式"/>

                            <TextBlock Grid.Row="2" Text="错误恢复：" Classes="FieldLabel" VerticalAlignment="Center" Margin="0,8,0,0"/>
                            <ComboBox x:Name="CmbDefaultErrorRecovery" Grid.Row="2" Grid.Column="1"
                                      HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                      ToolTip.Tip="如何处理读取错误"/>

                            <TextBlock Grid.Row="3" Text="子通道模式：" Classes="FieldLabel" VerticalAlignment="Center" Margin="0,8,0,0"/>
                            <ComboBox x:Name="CmbDefaultSubchannel" Grid.Row="3" Grid.Column="1"
                                      HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                      ToolTip.Tip="特殊光盘格式的子通道提取模式"/>

                            <TextBlock Grid.Row="4" Text="扇区大小：" Classes="FieldLabel" VerticalAlignment="Center" Margin="0,8,0,0"/>
                            <ComboBox x:Name="CmbDefaultSectorSize" Grid.Row="4" Grid.Column="1"
                                      HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                      ToolTip.Tip="扇区大小 — 数据为 2048，原始/音频为 2352"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="读取重试次数：" Classes="FieldLabel" VerticalAlignment="Center"/>
                            <NumericUpDown x:Name="NudDefaultReadRetries" Minimum="0" Maximum="100"
                                           Value="3" Width="100"
                                           ToolTip.Tip="扇区读取失败时的重试次数"/>
                        </StackPanel>

                        <CheckBox x:Name="ChkDefaultAudioParanoia"
                                  Content="启用音频精确抓取模式（更准确，但较慢）"
                                  Foreground="#E8F0FE"
                                  ToolTip.Tip="抓取音频 CD 时使用精确级纠错"/>
                        <CheckBox x:Name="ChkDefaultJitterCorrection"
                                  Content="启用读取抖动校正"
                                  Foreground="#E8F0FE"
                                  ToolTip.Tip="在音频提取过程中校正抖动错误"/>
                    </StackPanel>
                </Border>

                <!-- ============================================================ -->
                <!-- VERIFICATION -->
                <!-- ============================================================ -->
                <Border x:Name="SectionVerification" Classes="Card">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="✅" FontSize="16"/>
                            <TextBlock Text="校验设置" Classes="SectionHeader"/>
                        </StackPanel>
                        <TextBlock Text="配置默认校验和算法和自动校验行为。"
                                   Foreground="#5A7A9A" FontSize="11"/>

                        <Grid ColumnDefinitions="180,*" Margin="0,4,0,0">
                            <TextBlock Text="校验和算法：" Classes="FieldLabel" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbDefaultChecksum" Grid.Column="1"
                                      HorizontalAlignment="Stretch"
                                      ToolTip.Tip="光盘校验的默认哈希算法"/>
                        </Grid>

                        <CheckBox x:Name="ChkAutoVerifyAfterRead"
                                  Content="读取/复制操作后自动校验光盘"
                                  Foreground="#E8F0FE"
                                  ToolTip.Tip="将光盘复制为镜像后执行一次校验"/>
                    </StackPanel>
                </Border>

                <!-- ============================================================ -->
                <!-- FILE SYSTEM DEFAULTS -->
                <!-- ============================================================ -->
                <Border x:Name="SectionFileSystem" Classes="Card">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="📂" FontSize="16"/>
                            <TextBlock Text="文件系统默认值" Classes="SectionHeader"/>
                        </StackPanel>
                        <TextBlock Text="构建数据光盘和镜像的默认文件系统设置。"
                                   Foreground="#5A7A9A" FontSize="11"/>

                        <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
                            <TextBlock Text="文件系统：" Classes="FieldLabel" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbDefaultFileSystem" Grid.Column="1"
                                      HorizontalAlignment="Stretch"
                                      ToolTip.Tip="新数据光盘项目的默认文件系统"/>

                            <TextBlock Grid.Row="1" Text="UDF 版本：" Classes="FieldLabel" VerticalAlignment="Center" Margin="0,8,0,0"/>
                            <ComboBox x:Name="CmbDefaultUdfRevision" Grid.Row="1" Grid.Column="1"
                                      HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                      ToolTip.Tip="使用 UDF 文件系统时的默认 UDF 版本"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <TextBlock Text="默认卷标：" Classes="FieldLabel" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtDefaultVolumeLabel"
                                     Width="300" Watermark="例如 MY_DISC"
                                     Background="#152030" Foreground="#E8F0FE"
                                     ToolTip.Tip="新光盘项目的默认卷标"/>
                        </StackPanel>

                        <CheckBox x:Name="ChkAllowLongFileNames"
                                  Content="允许长文件名（Joliet 扩展）"
                                  Foreground="#E8F0FE"
                                  ToolTip.Tip="允许文件名超过 ISO 9660 的 8.3 限制"/>
                        <CheckBox x:Name="ChkAllowDeepDirs"
                                  Content="允许深层目录嵌套（超过 8 层）"
                                  Foreground="#E8F0FE"
                                  ToolTip.Tip="允许目录结构超过 ISO 9660 限制"/>
                    </StackPanel>
                </Border>

                <!-- ============================================================ -->
                <!-- AUDIO CD DEFAULTS -->
                <!-- ============================================================ -->
                <Border x:Name="SectionAudioCd" Classes="Card">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="🎵" FontSize="16"/>
                            <TextBlock Text="音频 CD 默认值" Classes="SectionHeader"/>
                        </StackPanel>
                        <TextBlock Text="创建和刻录音频 CD 的默认设置。"
                                   Foreground="#5A7A9A" FontSize="11"/>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="音轨间隔（秒）：" Classes="FieldLabel" VerticalAlignment="Center"/>
                            <NumericUpDown x:Name="NudAudioTrackGap" Minimum="0" Maximum="10"
                                           Value="2" Width="100"
                                           ToolTip.Tip="音轨之间的静音间隔（秒）"/>
                        </StackPanel>

                        <CheckBox x:Name="ChkAudioNormalization"
                                  Content="标准化音轨音量"
                                  Foreground="#E8F0FE"
                                  ToolTip.Tip="使所有音轨的音量一致"/>
                        <CheckBox x:Name="ChkCdText"
                                  Content="启用 CD-TEXT 文本（嵌入音轨/专辑标题）"
                                  Foreground="#E8F0FE"
                                  ToolTip.Tip="写入包含艺术家和标题信息的 CD-TEXT 数据"/>
                        <CheckBox x:Name="ChkGaplessPlayback"
                                  Content="无缝播放（音轨之间无静音）"
                                  Foreground="#E8F0FE"
                                  ToolTip.Tip="移除音轨之间的间隔以实现无缝播放"/>
                    </StackPanel>
                </Border>

                <!-- ============================================================ -->
                <!-- I/O & PERFORMANCE -->
                <!-- ============================================================ -->
                <Border x:Name="SectionIoPerf" Classes="Card">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="⚡&#xFE0F;" FontSize="16"/>
                            <TextBlock Text="I/O 与性能" Classes="SectionHeader"/>
                        </StackPanel>
                        <TextBlock Text="底层 I/O 和 SCSI 性能调优。更改这些设置可能影响刻录稳定性。"
                                   Foreground="#5A7A9A" FontSize="11"/>

                        <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,4,0,0">
                            <TextBlock Text="I/O 缓冲区大小（KB）：" Classes="FieldLabel" VerticalAlignment="Center"/>
                            <NumericUpDown x:Name="NudIoBufferSize" Grid.Column="1"
                                           Minimum="16" Maximum="4096" Value="64" Width="120"
                                           ToolTip.Tip="读写操作的缓冲区大小（KB）"/>

                            <TextBlock Grid.Row="1" Text="传输长度（KB）：" Classes="FieldLabel" VerticalAlignment="Center" Margin="0,8,0,0"/>
                            <NumericUpDown x:Name="NudTransferLength" Grid.Row="1" Grid.Column="1"
                                           Minimum="16" Maximum="256" Value="64" Width="120" Margin="0,8,0,0"
                                           ToolTip.Tip="每条 SCSI I/O 指令传输的 KB 数"/>

                            <TextBlock Grid.Row="2" Text="SCSI 写入重试：" Classes="FieldLabel" VerticalAlignment="Center" Margin="0,8,0,0"/>
                            <NumericUpDown x:Name="NudScsiWriteRetries" Grid.Row="2" Grid.Column="1"
                                           Minimum="0" Maximum="100" Value="20" Width="120" Margin="0,8,0,0"
                                           ToolTip.Tip="暂时性 SCSI 错误的写入重试次数"/>

                            <TextBlock Grid.Row="3" Text="SCSI 读取重试：" Classes="FieldLabel" VerticalAlignment="Center" Margin="0,8,0,0"/>
                            <NumericUpDown x:Name="NudScsiReadRetries" Grid.Row="3" Grid.Column="1"
                                           Minimum="0" Maximum="100" Value="20" Width="120" Margin="0,8,0,0"
                                           ToolTip.Tip="暂时性 SCSI 错误的读取重试次数"/>
                        </Grid>

                        <CheckBox x:Name="ChkDirectIo"
                                  Content="启用直接（无缓冲）I/O"
                                  Foreground="#E8F0FE"
                                  ToolTip.Tip="绕过操作系统缓存，在某些系统上可能更快"/>
                        <CheckBox x:Name="ChkExclusiveDrive"
                                  Content="独占光驱访问（防止其他程序干扰）"
                                  Foreground="#E8F0FE"
                                  ToolTip.Tip="操作期间独占锁定光驱以避免冲突"/>
                    </StackPanel>
                </Border>

                <!-- ============================================================ -->
                <!-- POST-OPERATION ACTIONS -->
                <!-- ============================================================ -->
                <Border x:Name="SectionPostActions" Classes="Card">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="🔔" FontSize="16"/>
                            <TextBlock Text="操作后动作" Classes="SectionHeader"/>
                        </StackPanel>
                        <TextBlock Text="配置刻录、读取或擦除操作完成后的行为。"
                                   Foreground="#5A7A9A" FontSize="11"/>

                        <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4,0,0">
                            <TextBlock Text="刻录成功后：" Classes="FieldLabel" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbPostBurnAction" Grid.Column="1"
                                      HorizontalAlignment="Stretch"
                                      ToolTip.Tip="刻录成功完成后执行的动作"/>

                            <TextBlock Grid.Row="1" Text="读取成功后：" Classes="FieldLabel" VerticalAlignment="Center" Margin="0,8,0,0"/>
                            <ComboBox x:Name="CmbPostReadAction" Grid.Row="1" Grid.Column="1"
                                      HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                      ToolTip.Tip="光盘复制成功完成后执行的动作"/>

                            <TextBlock Grid.Row="2" Text="擦除成功后：" Classes="FieldLabel" VerticalAlignment="Center" Margin="0,8,0,0"/>
                            <ComboBox x:Name="CmbPostEraseAction" Grid.Row="2" Grid.Column="1"
                                      HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                      ToolTip.Tip="光盘擦除完成后执行的动作"/>
                        </Grid>

                        <CheckBox x:Name="ChkSoundOnComplete"
                                  Content="操作完成时播放提示音"
                                  Foreground="#E8F0FE"
                                  ToolTip.Tip="操作结束时播放声音提示"/>
                        <CheckBox x:Name="ChkSoundOnError"
                                  Content="出错时播放提示音"
                                  Foreground="#E8F0FE"
                                  ToolTip.Tip="发生错误时播放声音提示"/>
                        <CheckBox x:Name="ChkNotificationOnComplete"
                                  Content="操作完成时显示桌面通知"
                                  Foreground="#E8F0FE"
                                  ToolTip.Tip="操作结束时显示系统通知"/>
                    </StackPanel>
                </Border>

                <!-- ============================================================ -->
                <!-- LOGGING & DIAGNOSTICS -->
                <!-- ============================================================ -->
                <Border x:Name="SectionLogging" Classes="Card">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="📋" FontSize="16"/>
                            <TextBlock Text="日志与诊断" Classes="SectionHeader"/>
                        </StackPanel>
                        <TextBlock Text="配置操作日志、详细程度和日志文件管理。"
                                   Foreground="#5A7A9A" FontSize="11"/>

                        <CheckBox x:Name="ChkEnableLogging"
                                  Content="启用操作日志写入文件"
                                  Foreground="#E8F0FE"
                                  ToolTip.Tip="将详细操作日志写入日志目录"/>

                        <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4,0,0">
                            <TextBlock Text="日志级别：" Classes="FieldLabel" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbLogLevel" Grid.Column="1"
                                      HorizontalAlignment="Stretch"
                                      ToolTip.Tip="日志文件中包含的详细程度"/>

                            <TextBlock Grid.Row="1" Text="日志文件大小上限（MB）：" Classes="FieldLabel" VerticalAlignment="Center" Margin="0,8,0,0"/>
                            <NumericUpDown x:Name="NudMaxLogSize" Grid.Row="1" Grid.Column="1"
                                           Minimum="1" Maximum="500" Value="10" Width="120" Margin="0,8,0,0"
                                           ToolTip.Tip="单个日志文件轮转前的最大大小"/>

                            <TextBlock Grid.Row="2" Text="保留日志文件数：" Classes="FieldLabel" VerticalAlignment="Center" Margin="0,8,0,0"/>
                            <NumericUpDown x:Name="NudLogRetention" Grid.Row="2" Grid.Column="1"
                                           Minimum="1" Maximum="50" Value="5" Width="120" Margin="0,8,0,0"
                                           ToolTip.Tip="保留的旧日志文件数量"/>
                        </Grid>

                        <CheckBox x:Name="ChkLogScsiCommands"
                                  Content="在日志中包含 SCSI/MMC 指令详情（详细）"
                                  Foreground="#E8F0FE"
                                  ToolTip.Tip="记录原始 SCSI 指令和响应以便调试"/>
                    </StackPanel>
                </Border>

                <!-- ============================================================ -->
                <!-- PATHS & LOCATIONS -->
                <!-- ============================================================ -->
                <Border x:Name="SectionPaths" Classes="Card">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="📁" FontSize="16"/>
                            <TextBlock Text="路径与位置" Classes="SectionHeader"/>
                        </StackPanel>
                        <TextBlock Text="配置镜像输出、临时文件和日志的默认目录。"
                                   Foreground="#5A7A9A" FontSize="11"/>

                        <StackPanel Spacing="8">
                            <TextBlock Text="默认镜像输出目录：" Classes="FieldLabel"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox x:Name="TxtDefaultImageDir"
                                         Watermark="留空则使用系统默认值…"
                                         Background="#152030" Foreground="#E8F0FE"
                                         ToolTip.Tip="保存光盘镜像的默认目录"/>
                                <Button x:Name="BtnBrowseImageDir" Grid.Column="1"
                                        Content="浏览…" Classes="ActionBtn"
                                        Margin="6,0,0,0" Click="OnBrowseImageDirClick"
                                        ToolTip.Tip="浏览并选择目录"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="临时文件目录：" Classes="FieldLabel"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox x:Name="TxtTempDir"
                                         Watermark="留空则使用系统默认值…"
                                         Background="#152030" Foreground="#E8F0FE"
                                         ToolTip.Tip="存放构建临时文件的目录"/>
                                <Button x:Name="BtnBrowseTempDir" Grid.Column="1"
                                        Content="浏览…" Classes="ActionBtn"
                                        Margin="6,0,0,0" Click="OnBrowseTempDirClick"
                                        ToolTip.Tip="浏览并选择目录"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="日志文件目录：" Classes="FieldLabel"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox x:Name="TxtLogDir"
                                         Watermark="留空则使用应用数据默认目录…"
                                         Background="#152030" Foreground="#E8F0FE"
                                         ToolTip.Tip="自定义日志文件目录"/>
                                <Button x:Name="BtnBrowseLogDir" Grid.Column="1"
                                        Content="浏览…" Classes="ActionBtn"
                                        Margin="6,0,0,0" Click="OnBrowseLogDirClick"
                                        ToolTip.Tip="浏览并选择目录"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============================================================ -->
                <!-- ADVANCED & SAFETY -->
                <!-- ============================================================ -->
                <Border x:Name="SectionAdvanced" Classes="Card">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="🔧" FontSize="16"/>
                            <TextBlock Text="高级与安全" Classes="SectionHeader"/>
                        </StackPanel>
                        <TextBlock Text="面向高级用户的高级选项。错误的设置可能导致刻录失败。"
                                   Foreground="#FF8C00" FontSize="11"/>

                        <CheckBox x:Name="ChkExpertMode"
                                  Content="启用专家模式（显示更多底层选项）"
                                  Foreground="#E8F0FE"
                                  ToolTip.Tip="在刻录、读取和构建视图中显示高级选项"/>
                        <CheckBox x:Name="ChkAutoDetectSpeed"
                                  Content="自动检测并建议最佳写入速度"
                                  Foreground="#E8F0FE"
                                  ToolTip.Tip="分析介质质量并建议最佳写入速度"/>
                        <CheckBox x:Name="ChkMediaCompat"
                                  Content="刻录前执行介质兼容性检查"
                                  Foreground="#E8F0FE"
                                  ToolTip.Tip="确认介质与所选操作兼容"/>
                        <CheckBox x:Name="ChkAutoDetectCaps"
                                  Content="自动检测光驱固件能力"
                                  Foreground="#E8F0FE"
                                  ToolTip.Tip="查询光驱固件支持的功能"/>
                        <CheckBox x:Name="ChkAllowSameSourceTarget"
                                  Content="允许源和目标使用同一光驱（不推荐）"
                                  Foreground="#FF8C00"
                                  ToolTip.Tip="警告：源和目标使用同一光驱可能导致数据丢失"/>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="默认换层位置：" Classes="FieldLabel" VerticalAlignment="Center"/>
                            <NumericUpDown x:Name="NudLayerBreak" Minimum="0" Maximum="4000000"
                                           Value="0" Width="140"
                                           ToolTip.Tip="双层介质的换层 LBA（0 = 自动）"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============================================================ -->
                <!-- GAMING DISC DEFAULTS -->
                <!-- ============================================================ -->
                <Border x:Name="SectionGaming" Classes="Card">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="🎮" FontSize="16"/>
                            <TextBlock Text="游戏光盘默认值" Classes="SectionHeader"/>
                        </StackPanel>
                        <TextBlock Text="游戏光盘操作的默认补丁和预设行为。"
                                   Foreground="#5A7A9A" FontSize="11"/>

                        <Grid ColumnDefinitions="220,*" Margin="0,4,0,0">
                            <TextBlock Text="默认游戏机预设：" Classes="FieldLabel" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbDefaultGamingPreset" Grid.Column="1"
                                      HorizontalAlignment="Stretch"
                                      ToolTip.Tip="游戏光盘向导的默认游戏机预设"/>
                        </Grid>

                        <CheckBox x:Name="ChkAutoEsrPatch"
                                  Content="自动为 PS2 DVD 镜像应用 ESR 补丁"
                                  Foreground="#E8F0FE"
                                  ToolTip.Tip="自动应用 ESR 补丁以兼容 PS2 DVD"/>
                        <CheckBox x:Name="ChkAutoRegionFree"
                                  Content="自动应用全区补丁"
                                  Foreground="#E8F0FE"
                                  ToolTip.Tip="自动移除游戏光盘的区域限制"/>
                    </StackPanel>
                </Border>

                <!-- Spacer at bottom -->
                <Border Height="20"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
