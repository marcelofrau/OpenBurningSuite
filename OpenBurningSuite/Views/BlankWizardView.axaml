<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OpenBurningSuite.Views.BlankWizardView">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24" Spacing="20">

            <!-- Page header -->
            <StackPanel Spacing="4">
                <TextBlock Text="🧹  擦除光盘向导"
                           Classes="PageTitle" Foreground="#5BC0FF"/>
                <TextBlock Text="擦除可重写光盘或格式化空白 BD-R/DVD+RW 光盘 — 分步引导。"
                           Classes="PageSubtitle" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Step indicators -->
            <Border Classes="Card">
                <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
                    <TextBlock x:Name="TxtBlankStep1Ind" Text="① 选择光驱" Foreground="#5BC0FF" FontWeight="Bold"/>
                    <TextBlock Text="→" Foreground="#5A7A9A"/>
                    <TextBlock x:Name="TxtBlankStep2Ind" Text="② 选项" Foreground="#5A7A9A"/>
                    <TextBlock Text="→" Foreground="#5A7A9A"/>
                    <TextBlock x:Name="TxtBlankStep3Ind" Text="③ 擦除" Foreground="#5A7A9A"/>
                </StackPanel>
            </Border>

            <!-- ============================================================ -->
            <!-- Step 1: Drive Selection                                      -->
            <!-- ============================================================ -->
            <StackPanel x:Name="PnlBlankStep1" Spacing="12">
                <TextBlock Text="选择光驱" Classes="SectionHeader"/>

                <Border Classes="Card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="选择装有可重写光盘的光驱："
                                   Foreground="#8EAFC8" TextWrapping="Wrap"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <ComboBox x:Name="CmbBlankDrive" PlaceholderText="选择光驱…"
                                      SelectionChanged="OnBlankDriveSelChanged"
                                      ToolTip.Tip="选择装有待擦除光盘的光驱"/>
                            <Button x:Name="BtnBlankRefresh" Grid.Column="1" Content="🔄 刷新"
                                    Classes="ActionBtn" Margin="8,0,0,0" Click="OnBlankRefreshClick"/>
                        </Grid>

                        <!-- Drive & media info -->
                        <Border Classes="InfoCard" Padding="12">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="TxtBlankDriveInfo" Text="未选择光驱"
                                           Foreground="#8EAFC8" TextWrapping="Wrap"/>
                                <TextBlock x:Name="TxtBlankMediaInfo" Text=""
                                           Foreground="#5A7A9A" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Compatibility warnings -->
                        <TextBlock x:Name="TxtBlankWarning" Text=""
                                   Foreground="#FFB74D" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============================================================ -->
            <!-- Step 2: Erase Options                                        -->
            <!-- ============================================================ -->
            <StackPanel x:Name="PnlBlankStep2" Spacing="12" IsVisible="False">
                <TextBlock Text="擦除选项" Classes="SectionHeader"/>

                <Border Classes="Card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="选择擦除光盘的方式："
                                   Foreground="#8EAFC8" TextWrapping="Wrap"/>

                        <RadioButton x:Name="RdoQuickBlank" Content="快速擦除（快 — 仅擦除 TOC/PMA）"
                                     IsChecked="True" Foreground="#E8F0FE" GroupName="BlankMode"
                                     ToolTip.Tip="仅擦除目录区 — 快得多，但数据仍留在光盘上"/>
                        <RadioButton x:Name="RdoFullBlank" Content="完全擦除（慢 — 擦除整张光盘表面）"
                                     Foreground="#E8F0FE" GroupName="BlankMode"
                                     ToolTip.Tip="向整张光盘写入零 — 非常慢但会彻底清除所有数据"/>

                        <Border Classes="InfoCard" Padding="12" Margin="0,8,0,0">
                            <StackPanel Spacing="4">
                                <TextBlock Text="ℹ 快速擦除与完全擦除" Foreground="#5BC0FF" FontWeight="Bold" FontSize="12"/>
                                <TextBlock Text="快速擦除只需几秒即可让光盘重新可写，但旧数据仍留在光盘上（不使用特殊工具无法读取）。完全擦除会用零覆写所有扇区 — 根据光盘类型和速度，可能需要 15-60 分钟以上。"
                                           Foreground="#8EAFC8" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="兼容介质类型：CD-RW、DVD-RW、DVD+RW、DVD-RAM、BD-RE、HD DVD-RW"
                                   Foreground="#5A7A9A" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <TextBlock Text="BD-R 和 DVD+R/DVD-R 是一次性写入介质，可以格式化但不能擦除。"
                                   Foreground="#5A7A9A" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============================================================ -->
            <!-- Step 3: Execute                                              -->
            <!-- ============================================================ -->
            <StackPanel x:Name="PnlBlankStep3" Spacing="12" IsVisible="False">
                <TextBlock Text="正在擦除光盘…" Classes="SectionHeader"/>

                <Border Classes="Card">
                    <StackPanel Spacing="12">
                        <ProgressBar x:Name="PrgBlankExec" Classes="BurnProgress" Value="0"
                                     IsIndeterminate="True"/>
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock x:Name="TxtBlankExecStatus" Text="正在擦除…"
                                       Foreground="#8EAFC8" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtBlankExecETA" Text=""
                                       Foreground="#5A7A9A" FontSize="11"
                                       Grid.Column="1" VerticalAlignment="Center"
                                       Margin="12,0"/>
                            <TextBlock x:Name="TxtBlankExecPercent" Text=""
                                       Foreground="#E8F0FE" FontSize="13"
                                       FontWeight="SemiBold"
                                       Grid.Column="2" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBox x:Name="TxtBlankExecLog" Classes="LogBox" Height="160"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============================================================ -->
            <!-- Navigation Buttons                                           -->
            <!-- ============================================================ -->
            <Border Classes="InfoCard" Margin="0,8,0,0">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <Button x:Name="BtnBlankBack" Content="← 上一步"
                            Classes="ActionBtn" Click="OnBlankBackClick"
                            IsVisible="False"
                            ToolTip.Tip="返回上一步"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="BtnBlankCancel" Content="取消"
                                Classes="ActionBtn" Click="OnBlankCancelClick"
                                IsVisible="False"
                                ToolTip.Tip="取消擦除操作"/>
                        <Button x:Name="BtnBlankNext" Content="下一步 →"
                                Classes="ActionBtn" Click="OnBlankNextClick"
                                ToolTip.Tip="进入下一步"/>
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
