<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:OpenBurningSuite.Views"
             x:Class="OpenBurningSuite.Views.VideoWizardView">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24" Spacing="20">

            <!-- Page header -->
            <StackPanel Spacing="4">
                <TextBlock Text="🎬  视频光盘向导"
                           Classes="PageTitle" Foreground="#5BC0FF"/>
                <TextBlock Text="从视频文件夹和文件创建 DVD-Video、蓝光、BDAV、3D 蓝光、VCD 或 SVCD 光盘 — 分步引导。"
                           Classes="PageSubtitle" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Step indicator -->
            <Border Classes="InfoCard">
                <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border x:Name="VStepInd1" Background="#1E90FF" CornerRadius="12"
                                Width="24" Height="24" Padding="0">
                            <TextBlock Text="1" Foreground="White" FontSize="12"
                                       FontWeight="Bold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="VStepLbl1" Text="选择任务"
                                   Foreground="#E8F0FE" FontSize="12"
                                   VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock Text="→" Foreground="#5A7A9A" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border x:Name="VStepInd2" Background="#1E3450" CornerRadius="12"
                                Width="24" Height="24" Padding="0">
                            <TextBlock Text="2" Foreground="#5A7A9A" FontSize="12"
                                       FontWeight="Bold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="VStepLbl2" Text="配置"
                                   Foreground="#5A7A9A" FontSize="12"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="→" Foreground="#5A7A9A" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border x:Name="VStepInd3" Background="#1E3450" CornerRadius="12"
                                Width="24" Height="24" Padding="0">
                            <TextBlock Text="3" Foreground="#5A7A9A" FontSize="12"
                                       FontWeight="Bold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="VStepLbl3" Text="摘要"
                                   Foreground="#5A7A9A" FontSize="12"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="→" Foreground="#5A7A9A" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border x:Name="VStepInd4" Background="#1E3450" CornerRadius="12"
                                Width="24" Height="24" Padding="0">
                            <TextBlock Text="4" Foreground="#5A7A9A" FontSize="12"
                                       FontWeight="Bold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="VStepLbl4" Text="执行"
                                   Foreground="#5A7A9A" FontSize="12"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============================================================ -->
            <!-- STEP 1: Choose Task                                          -->
            <!-- ============================================================ -->
            <StackPanel x:Name="Step1Panel" Spacing="16">
                <TextBlock Text="您想执行什么操作？" Classes="SectionHeader"/>

                <WrapPanel Orientation="Horizontal">
                    <!-- Video DVD from Folder -->
                    <Button x:Name="BtnModeDvd" Classes="NavBtn" Margin="0,0,12,12"
                            Width="260" Height="130"
                            HorizontalContentAlignment="Center"
                            Click="OnModeDvd"
                            ToolTip.Tip="从 VIDEO_TS 文件夹创建并刻录 DVD-Video 光盘">
                        <StackPanel HorizontalAlignment="Center" Spacing="8">
                            <TextBlock Text="📀" FontSize="36" HorizontalAlignment="Center"/>
                            <TextBlock Text="从文件夹创建视频 DVD" FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Foreground="#E8F0FE"/>
                            <TextBlock Text="从 VIDEO_TS 文件夹创建并刻录 DVD-Video 光盘"
                                       FontSize="11" Foreground="#5A7A9A"
                                       HorizontalAlignment="Center" TextWrapping="Wrap"
                                       TextAlignment="Center" MaxWidth="220"/>
                        </StackPanel>
                    </Button>

                    <!-- Video Blu-ray from Folder -->
                    <Button x:Name="BtnModeBluray" Classes="NavBtn" Margin="0,0,12,12"
                            Width="260" Height="130"
                            HorizontalContentAlignment="Center"
                            Click="OnModeBluray"
                            ToolTip.Tip="从 BDMV 文件夹创建并刻录蓝光光盘">
                        <StackPanel HorizontalAlignment="Center" Spacing="8">
                            <TextBlock Text="💿" FontSize="36" HorizontalAlignment="Center"/>
                            <TextBlock Text="从文件夹创建视频蓝光" FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Foreground="#E8F0FE"/>
                            <TextBlock Text="从 BDMV 文件夹创建并刻录蓝光光盘"
                                       FontSize="11" Foreground="#5A7A9A"
                                       HorizontalAlignment="Center" TextWrapping="Wrap"
                                       TextAlignment="Center" MaxWidth="220"/>
                        </StackPanel>
                    </Button>

                    <!-- BDAV (Blu-ray Recording) from Folder -->
                    <Button x:Name="BtnModeBdav" Classes="NavBtn" Margin="0,0,12,12"
                            Width="260" Height="130"
                            HorizontalContentAlignment="Center"
                            Click="OnModeBdav"
                            ToolTip.Tip="从 BDAV 文件夹创建并刻录 BDAV 录像光盘">
                        <StackPanel HorizontalAlignment="Center" Spacing="8">
                            <TextBlock Text="📹" FontSize="36" HorizontalAlignment="Center"/>
                            <TextBlock Text="从文件夹创建 BDAV 录像" FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Foreground="#E8F0FE"/>
                            <TextBlock Text="从 BDAV 录像文件夹创建并刻录 BDAV 光盘"
                                       FontSize="11" Foreground="#5A7A9A"
                                       HorizontalAlignment="Center" TextWrapping="Wrap"
                                       TextAlignment="Center" MaxWidth="220"/>
                        </StackPanel>
                    </Button>

                    <!-- 3D Blu-ray from Folder -->
                    <Button x:Name="BtnModeBd3d" Classes="NavBtn" Margin="0,0,12,12"
                            Width="260" Height="130"
                            HorizontalContentAlignment="Center"
                            Click="OnModeBd3d"
                            ToolTip.Tip="从 BDMV 3D 文件夹创建并刻录 3D 蓝光光盘">
                        <StackPanel HorizontalAlignment="Center" Spacing="8">
                            <TextBlock Text="🎥" FontSize="36" HorizontalAlignment="Center"/>
                            <TextBlock Text="从文件夹创建 3D 蓝光" FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Foreground="#E8F0FE"/>
                            <TextBlock Text="从 BDMV 3D 文件夹创建并刻录 3D 蓝光光盘"
                                       FontSize="11" Foreground="#5A7A9A"
                                       HorizontalAlignment="Center" TextWrapping="Wrap"
                                       TextAlignment="Center" MaxWidth="220"/>
                        </StackPanel>
                    </Button>

                    <!-- UHD Blu-ray from Folder -->
                    <Button x:Name="BtnModeUhdBluray" Classes="NavBtn" Margin="0,0,12,12"
                            Width="260" Height="130"
                            HorizontalContentAlignment="Center"
                            Click="OnModeUhdBluray"
                            ToolTip.Tip="从 BDMV 文件夹创建并刻录 UHD（4K HDR）蓝光光盘">
                        <StackPanel HorizontalAlignment="Center" Spacing="8">
                            <TextBlock Text="🎬" FontSize="36" HorizontalAlignment="Center"/>
                            <TextBlock Text="从文件夹创建 UHD 蓝光" FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Foreground="#E8F0FE"/>
                            <TextBlock Text="从 BDMV 创建并刻录 UHD 4K HDR 蓝光光盘"
                                       FontSize="11" Foreground="#5A7A9A"
                                       HorizontalAlignment="Center" TextWrapping="Wrap"
                                       TextAlignment="Center" MaxWidth="220"/>
                        </StackPanel>
                    </Button>

                    <!-- Video CD (VCD) -->
                    <Button x:Name="BtnModeVcd" Classes="NavBtn" Margin="0,0,12,12"
                            Width="260" Height="130"
                            HorizontalContentAlignment="Center"
                            Click="OnModeVcd"
                            ToolTip.Tip="从 MPEG-1 视频文件创建并刻录视频 CD">
                        <StackPanel HorizontalAlignment="Center" Spacing="8">
                            <TextBlock Text="📼" FontSize="36" HorizontalAlignment="Center"/>
                            <TextBlock Text="视频 CD（VCD）" FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Foreground="#E8F0FE"/>
                            <TextBlock Text="从 MPEG-1 视频文件创建并刻录视频 CD"
                                       FontSize="11" Foreground="#5A7A9A"
                                       HorizontalAlignment="Center" TextWrapping="Wrap"
                                       TextAlignment="Center" MaxWidth="220"/>
                        </StackPanel>
                    </Button>

                    <!-- Super Video CD (SVCD) -->
                    <Button x:Name="BtnModeSvcd" Classes="NavBtn" Margin="0,0,12,12"
                            Width="260" Height="130"
                            HorizontalContentAlignment="Center"
                            Click="OnModeSvcd"
                            ToolTip.Tip="从 MPEG-2 视频文件创建并刻录超级视频 CD">
                        <StackPanel HorizontalAlignment="Center" Spacing="8">
                            <TextBlock Text="📼" FontSize="36" HorizontalAlignment="Center"/>
                            <TextBlock Text="超级视频 CD（SVCD）" FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Foreground="#E8F0FE"/>
                            <TextBlock Text="从 MPEG-2 视频文件创建并刻录超级视频 CD"
                                       FontSize="11" Foreground="#5A7A9A"
                                       HorizontalAlignment="Center" TextWrapping="Wrap"
                                       TextAlignment="Center" MaxWidth="220"/>
                        </StackPanel>
                    </Button>

                    <!-- XSVCD (eXtended Super Video CD) -->
                    <Button x:Name="BtnModeXsvcd" Classes="NavBtn" Margin="0,0,12,12"
                            Width="260" Height="130"
                            HorizontalContentAlignment="Center"
                            Click="OnModeXsvcd"
                            ToolTip.Tip="使用非标准 MPEG-2 参数创建并刻录扩展超级视频 CD">
                        <StackPanel HorizontalAlignment="Center" Spacing="8">
                            <TextBlock Text="📼" FontSize="36" HorizontalAlignment="Center"/>
                            <TextBlock Text="XSVCD（扩展 SVCD）" FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Foreground="#E8F0FE"/>
                            <TextBlock Text="以扩展码率和分辨率创建并刻录 XSVCD"
                                       FontSize="11" Foreground="#5A7A9A"
                                       HorizontalAlignment="Center" TextWrapping="Wrap"
                                       TextAlignment="Center" MaxWidth="220"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>

            <!-- ============================================================ -->
            <!-- STEP 2A: DVD-Video from Folder                               -->
            <!-- ============================================================ -->
            <StackPanel x:Name="Step2DvdPanel" IsVisible="False" Spacing="16">
                <TextBlock Text="从文件夹创建 DVD-Video — 配置并刻录" Classes="SectionHeader"/>

                <!-- Source VIDEO_TS Folder -->
                <Border Classes="Card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="📂 源 VIDEO_TS 文件夹" Classes="SectionHeader"/>
                        <TextBlock Text="选择包含 VIDEO_TS 的文件夹（内含 VOB、IFO 和 BUP 文件）。"
                                   Foreground="#5A7A9A" FontSize="11"/>
                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                            <TextBox x:Name="TxtDvdSourceFolder"
                                     Watermark="VIDEO_TS 文件夹路径…"
                                     Grid.Column="0"/>
                            <Button Content="📂 浏览" Classes="ActionBtn"
                                    Grid.Column="1" Margin="8,0,0,0"
                                    Click="OnBrowseDvdSourceClick"
                                    ToolTip.Tip="浏览并选择 VIDEO_TS 文件夹"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- DVD Settings -->
                <Border Classes="Card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="📀 DVD 设置" Classes="SectionHeader"/>
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4" Margin="0,0,8,8">
                                <TextBlock Text="视频制式" Classes="FieldLabel"/>
                                <ComboBox x:Name="CmbDvdVideoStandard" HorizontalAlignment="Stretch"
                                          ToolTip.Tip="DVD 的视频制式">
                                    <ComboBoxItem Content="NTSC (720×480, 29.97fps)" IsSelected="True"/>
                                    <ComboBoxItem Content="PAL (720×576, 25fps)"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4" Margin="0,0,0,8">
                                <TextBlock Text="宽高比" Classes="FieldLabel"/>
                                <ComboBox x:Name="CmbDvdAspectRatio" HorizontalAlignment="Stretch"
                                          ToolTip.Tip="DVD 的显示宽高比">
                                    <ComboBoxItem Content="16:9" IsSelected="True"/>
                                    <ComboBoxItem Content="4:3"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                <TextBlock Text="卷标" Classes="FieldLabel"/>
                                <TextBox x:Name="TxtDvdVolumeLabel" Watermark="DVD_VIDEO"
                                         MaxLength="32"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4" Margin="0,0,0,0">
                                <TextBlock Text="区域" Classes="FieldLabel"/>
                                <ComboBox x:Name="CmbDvdRegion" HorizontalAlignment="Stretch"
                                          ToolTip.Tip="DVD 区域码">
                                    <ComboBoxItem Content="Region Free" IsSelected="True"/>
                                    <ComboBoxItem Content="Region 1 (USA, Canada)"/>
                                    <ComboBoxItem Content="Region 2 (Europe, Japan)"/>
                                    <ComboBoxItem Content="Region 3 (Southeast Asia)"/>
                                    <ComboBoxItem Content="Region 4 (Latin America, Oceania)"/>
                                    <ComboBoxItem Content="Region 5 (Africa, Asia)"/>
                                    <ComboBoxItem Content="Region 6 (China)"/>
                                    <ComboBoxItem Content="Region 7 (Reserved)"/>
                                    <ComboBoxItem Content="Region 8 (Special Venues)"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Output Image Path -->
                <Border Classes="Card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="💾 输出镜像" Classes="SectionHeader"/>
                        <TextBlock Text="DVD 镜像（ISO）将保存到此位置。"
                                   Foreground="#5A7A9A" FontSize="11"/>
                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                            <TextBox x:Name="TxtDvdOutputPath"
                                     Watermark="DVD 镜像的保存路径…"
                                     Grid.Column="0"/>
                            <Button Content="📂 浏览" Classes="ActionBtn"
                                    Grid.Column="1" Margin="8,0,0,0"
                                    Click="OnBrowseDvdOutputClick"
                                    ToolTip.Tip="选择输出 DVD 镜像的保存位置"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Video Preview -->
                <Border Classes="InfoCard">
                    <StackPanel Spacing="12">
                        <TextBlock Text="🎬 视频预览" Classes="SectionHeader"/>

                        <Border Classes="DropZone">
                            <ListBox x:Name="LstDvdFiles"
                                     Background="Transparent"
                                     MinHeight="100" MaxHeight="260">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{Binding FileName}"
                                                           Foreground="#E8F0FE" FontSize="12"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding FilePath}"
                                                           Foreground="#5A7A9A" FontSize="10"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding SizeText}"
                                                       Foreground="#8EAFC8" FontSize="12"
                                                       VerticalAlignment="Center" Margin="8,0"/>
                                            <Button Grid.Column="2" Content="▶" FontSize="12"
                                                    Classes="ActionBtn" Padding="6,4"
                                                    Click="OnPreviewDvdFileClick"
                                                    Tag="{Binding FilePath}"
                                                    ToolTip.Tip="预览此文件"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <!-- Player Controls -->
                        <Border Classes="InfoCard">
                            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                                <Button x:Name="BtnDvdPlayPause" Content="▶ 播放"
                                        Classes="ActionBtn" Grid.Column="0"
                                        Click="OnDvdPlayPauseClick"
                                        ToolTip.Tip="播放或暂停选中的视频"/>
                                <Button Content="⏹ 停止" Classes="ActionBtn"
                                        Grid.Column="1" Margin="6,0,0,0"
                                        Click="OnDvdStopClick"
                                        ToolTip.Tip="停止播放"/>
                                <TextBlock x:Name="TxtDvdNowPlaying"
                                           Text="未选择文件"
                                           Foreground="#5A7A9A" FontSize="11"
                                           VerticalAlignment="Center"
                                           Grid.Column="2" Margin="12,0,0,0"/>
                                <Slider x:Name="SliderDvdPosition"
                                        Grid.Column="3" Minimum="0" Maximum="100"
                                        Margin="12,0" VerticalAlignment="Center"
                                        IsEnabled="False"
                                        ToolTip.Tip="播放位置"/>
                                <TextBlock x:Name="TxtDvdPlaybackTime"
                                           Text="00:00 / 00:00" Foreground="#8EAFC8"
                                           FontSize="11" Grid.Column="4"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Burn Settings -->
                <Border Classes="Card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="🔥 刻录设置" Classes="SectionHeader"/>
                        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto">
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4" Margin="0,0,8,8">
                                <TextBlock Text="目标光驱" Classes="FieldLabel"/>
                                <ComboBox x:Name="CmbDvdDrive" HorizontalAlignment="Stretch"
                                          ToolTip.Tip="选择刻录机"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4" Margin="0,0,8,8">
                                <TextBlock Text="写入速度" Classes="FieldLabel"/>
                                <ComboBox x:Name="CmbDvdSpeed" HorizontalAlignment="Stretch"
                                          ToolTip.Tip="刻录的写入速度">
                                    <ComboBoxItem Content="Auto" IsSelected="True"/>
                                    <ComboBoxItem Content="1x"/>
                                    <ComboBoxItem Content="2x"/>
                                    <ComboBoxItem Content="4x"/>
                                    <ComboBoxItem Content="6x"/>
                                    <ComboBoxItem Content="8x"/>
                                    <ComboBoxItem Content="12x"/>
                                    <ComboBoxItem Content="16x"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4" Margin="0,0,0,8">
                                <TextBlock Text="写入模式" Classes="FieldLabel"/>
                                <ComboBox x:Name="CmbDvdWriteMode" HorizontalAlignment="Stretch"
                                          ToolTip.Tip="DVD 刻录的写入策略">
                                    <ComboBoxItem Content="DAO (Disc At Once)" IsSelected="True"/>
                                    <ComboBoxItem Content="SAO (Session At Once)"/>
                                    <ComboBoxItem Content="TAO (Track At Once)"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                <TextBlock Text="份数" Classes="FieldLabel"/>
                                <NumericUpDown x:Name="NumDvdCopies" Minimum="1" Maximum="99"
                                               Value="1" FormatString="0"
                                               ToolTip.Tip="要刻录的光盘份数"/>
                            </StackPanel>
                        </Grid>
                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <CheckBox x:Name="ChkDvdEject" Content="刻录后弹出"
                                      IsChecked="True" Margin="0,0,16,6"
                                      ToolTip.Tip="刻录完成时弹出光盘"/>
                            <CheckBox x:Name="ChkDvdVerify" Content="刻录后校验"
                                      Margin="0,0,16,6"
                                      ToolTip.Tip="刻录后校验光盘完整性"/>
                            <CheckBox x:Name="ChkDvdSimulate" Content="模拟（测试写入）"
                                      Margin="0,0,16,6"
                                      ToolTip.Tip="模拟刻录而不实际写入光盘"/>
                            <CheckBox x:Name="ChkDvdBup" Content="缓存欠载保护"
                                      IsChecked="True" Margin="0,0,16,6"
                                      ToolTip.Tip="防止刻录过程中出现缓存欠载错误"/>
                            <CheckBox x:Name="ChkDvdBurnDisc"
                                      Content="同时刻录到光盘（不仅构建镜像）"
                                      IsChecked="True" Margin="0,0,16,6"
                                      ToolTip.Tip="取消勾选则仅创建 ISO 镜像而不刻录"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============================================================ -->
            <!-- STEP 2B: Video Blu-ray from Folder                           -->
            <!-- ============================================================ -->
            <StackPanel x:Name="Step2BdPanel" IsVisible="False" Spacing="16">
                <TextBlock Text="从文件夹创建视频蓝光 — 配置并刻录" Classes="SectionHeader"/>

                <!-- Source BDMV Folder -->
                <Border Classes="Card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="📂 源 BDMV 文件夹" Classes="SectionHeader"/>
                        <TextBlock Text="选择包含 BDMV 的文件夹（内含 STREAM、CLIPINF 和 PLAYLIST 文件夹）。"
                                   Foreground="#5A7A9A" FontSize="11"/>
                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                            <TextBox x:Name="TxtBdSourceFolder"
                                     Watermark="BDMV 文件夹路径…"
                                     Grid.Column="0"/>
                            <Button Content="📂 浏览" Classes="ActionBtn"
                                    Grid.Column="1" Margin="8,0,0,0"
                                    Click="OnBrowseBdSourceClick"
                                    ToolTip.Tip="浏览并选择 BDMV 文件夹"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Blu-ray Settings -->
                <Border Classes="Card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="💿 蓝光设置" Classes="SectionHeader"/>
                        <StackPanel Spacing="4">
                            <TextBlock Text="卷标" Classes="FieldLabel"/>
                            <TextBox x:Name="TxtBdVolumeLabel" Watermark="BLURAY_DISC"
                                     MaxLength="32"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Output Image Path -->
                <Border Classes="Card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="💾 输出镜像" Classes="SectionHeader"/>
                        <TextBlock Text="蓝光镜像（ISO）将保存到此位置。"
                                   Foreground="#5A7A9A" FontSize="11"/>
                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                            <TextBox x:Name="TxtBdOutputPath"
                                     Watermark="蓝光镜像的保存路径…"
                                     Grid.Column="0"/>
                            <Button Content="📂 浏览" Classes="ActionBtn"
                                    Grid.Column="1" Margin="8,0,0,0"
                                    Click="OnBrowseBdOutputClick"
                                    ToolTip.Tip="选择输出蓝光镜像的保存位置"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Video Preview -->
                <Border Classes="InfoCard">
                    <StackPanel Spacing="12">
                        <TextBlock Text="🎬 视频预览" Classes="SectionHeader"/>

                        <ListBox x:Name="LstBdFiles"
                                 Background="Transparent"
                                 MinHeight="100" MaxHeight="260">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="{Binding FileName}"
                                                       Foreground="#E8F0FE" FontSize="12"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding FilePath}"
                                                       Foreground="#5A7A9A" FontSize="10"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding SizeText}"
                                                   Foreground="#8EAFC8" FontSize="12"
                                                   VerticalAlignment="Center" Margin="8,0"/>
                                        <Button Grid.Column="2" Content="▶" FontSize="12"
                                                Classes="ActionBtn" Padding="6,4"
                                                Click="OnPreviewBdFileClick"
                                                Tag="{Binding FilePath}"
                                                ToolTip.Tip="预览此文件"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Player Controls -->
                        <Border Classes="InfoCard">
                            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                                <Button x:Name="BtnBdPlayPause" Content="▶ 播放"
                                        Classes="ActionBtn" Grid.Column="0"
                                        Click="OnBdPlayPauseClick"
                                        ToolTip.Tip="播放或暂停选中的视频"/>
                                <Button Content="⏹ 停止" Classes="ActionBtn"
                                        Grid.Column="1" Margin="6,0,0,0"
                                        Click="OnBdStopClick"
                                        ToolTip.Tip="停止播放"/>
                                <TextBlock x:Name="TxtBdNowPlaying"
                                           Text="未选择文件"
                                           Foreground="#5A7A9A" FontSize="11"
                                           VerticalAlignment="Center"
                                           Grid.Column="2" Margin="12,0,0,0"/>
                                <Slider x:Name="SliderBdPosition"
                                        Grid.Column="3" Minimum="0" Maximum="100"
                                        Margin="12,0" VerticalAlignment="Center"
                                        IsEnabled="False"
                                        ToolTip.Tip="播放位置"/>
                                <TextBlock x:Name="TxtBdPlaybackTime"
                                           Text="00:00 / 00:00" Foreground="#8EAFC8"
                                           FontSize="11" Grid.Column="4"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Burn Settings -->
                <Border Classes="Card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="🔥 刻录设置" Classes="SectionHeader"/>
                        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto">
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4" Margin="0,0,8,8">
                                <TextBlock Text="目标光驱" Classes="FieldLabel"/>
                                <ComboBox x:Name="CmbBdDrive" HorizontalAlignment="Stretch"
                                          ToolTip.Tip="选择刻录机"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4" Margin="0,0,8,8">
                                <TextBlock Text="写入速度" Classes="FieldLabel"/>
                                <ComboBox x:Name="CmbBdSpeed" HorizontalAlignment="Stretch"
                                          ToolTip.Tip="刻录的写入速度">
                                    <ComboBoxItem Content="Auto" IsSelected="True"/>
                                    <ComboBoxItem Content="1x"/>
                                    <ComboBoxItem Content="2x"/>
                                    <ComboBoxItem Content="4x"/>
                                    <ComboBoxItem Content="6x"/>
                                    <ComboBoxItem Content="8x"/>
                                    <ComboBoxItem Content="12x"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4" Margin="0,0,0,8">
                                <TextBlock Text="份数" Classes="FieldLabel"/>
                                <NumericUpDown x:Name="NumBdCopies" Minimum="1" Maximum="99"
                                               Value="1" FormatString="0"
                                               ToolTip.Tip="要刻录的光盘份数"/>
                            </StackPanel>
                        </Grid>
                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <CheckBox x:Name="ChkBdEject" Content="刻录后弹出"
                                      IsChecked="True" Margin="0,0,16,6"
                                      ToolTip.Tip="刻录完成时弹出光盘"/>
                            <CheckBox x:Name="ChkBdVerify" Content="刻录后校验"
                                      Margin="0,0,16,6"
                                      ToolTip.Tip="刻录后校验光盘完整性"/>
                            <CheckBox x:Name="ChkBdSimulate" Content="模拟（测试写入）"
                                      Margin="0,0,16,6"
                                      ToolTip.Tip="模拟刻录而不实际写入光盘"/>
                            <CheckBox x:Name="ChkBdBup" Content="缓存欠载保护"
                                      IsChecked="True" Margin="0,0,16,6"
                                      ToolTip.Tip="防止刻录过程中出现缓存欠载错误"/>
                            <CheckBox x:Name="ChkBdBurnDisc"
                                      Content="同时刻录到光盘（不仅构建镜像）"
                                      IsChecked="True" Margin="0,0,16,6"
                                      ToolTip.Tip="取消勾选则仅创建 ISO 镜像而不刻录"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============================================================ -->
            <!-- STEP 2E: BDAV (Blu-ray Recording) from Folder               -->
            <!-- ============================================================ -->
            <StackPanel x:Name="Step2BdavPanel" IsVisible="False" Spacing="16">
                <TextBlock Text="从文件夹创建 BDAV 录像 — 配置并刻录" Classes="SectionHeader"/>

                <!-- Source BDAV Folder -->
                <Border Classes="Card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="📂 源 BDAV 文件夹" Classes="SectionHeader"/>
                        <TextBlock Text="选择包含 BDAV 的文件夹（内含 STREAM、CLIPINF 和 PLAYLIST 文件夹）。"
                                   Foreground="#5A7A9A" FontSize="11"/>
                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                            <TextBox x:Name="TxtBdavSourceFolder"
                                     Watermark="BDAV 文件夹路径…"
                                     Grid.Column="0"/>
                            <Button Content="📂 浏览" Classes="ActionBtn"
                                    Grid.Column="1" Margin="8,0,0,0"
                                    Click="OnBrowseBdavSourceClick"
                                    ToolTip.Tip="浏览并选择 BDAV 文件夹"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- BDAV Settings -->
                <Border Classes="Card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="📹 BDAV 设置" Classes="SectionHeader"/>
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4" Margin="0,0,8,8">
                                <TextBlock Text="卷标" Classes="FieldLabel"/>
                                <TextBox x:Name="TxtBdavVolumeLabel" Watermark="BDAV_DISC"
                                         MaxLength="32"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4" Margin="0,0,0,8">
                                <TextBlock Text="光盘容量" Classes="FieldLabel"/>
                                <ComboBox x:Name="CmbBdavDiscSize" HorizontalAlignment="Stretch"
                                          ToolTip.Tip="BDAV 录像的目标光盘容量">
                                    <ComboBoxItem Content="BD-25 (25 GB)" IsSelected="True"/>
                                    <ComboBoxItem Content="BD-50 (50 GB)"/>
                                    <ComboBoxItem Content="BD-100 (BDXL 100 GB)"/>
                                    <ComboBoxItem Content="BD-128 (BDXL 128 GB)"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- BDAV Recording Metadata -->
                <Expander Classes="SettingsExpander" Header="⚙️ BDAV 录像元数据"
                          IsExpanded="False">
                    <StackPanel Spacing="8" Margin="0,12,0,0">
                        <TextBlock Text="BDAV 录像的可选元数据。标准录像请保留默认值。"
                                   Foreground="#5A7A9A" FontSize="11"/>
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto">
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                <TextBlock Text="录制日期" Classes="FieldLabel"/>
                                <DatePicker x:Name="DpBdavRecordingDate"
                                            ToolTip.Tip="BDAV 录像时间戳日期"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4" Margin="0,0,0,0">
                                <TextBlock Text="时区偏移（距 UTC 的分钟数）" Classes="FieldLabel"/>
                                <NumericUpDown x:Name="NumBdavTimezoneOffset" Minimum="-720" Maximum="840"
                                               Value="0" FormatString="0"
                                               ToolTip.Tip="UTC 时区偏移（分钟，-720 到 +840）"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- Output Image Path -->
                <Border Classes="Card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="💾 输出镜像" Classes="SectionHeader"/>
                        <TextBlock Text="BDAV 镜像（ISO）将保存到此位置。"
                                   Foreground="#5A7A9A" FontSize="11"/>
                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                            <TextBox x:Name="TxtBdavOutputPath"
                                     Watermark="BDAV 镜像的保存路径…"
                                     Grid.Column="0"/>
                            <Button Content="📂 浏览" Classes="ActionBtn"
                                    Grid.Column="1" Margin="8,0,0,0"
                                    Click="OnBrowseBdavOutputClick"
                                    ToolTip.Tip="选择输出 BDAV 镜像的保存位置"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Video Preview -->
                <Border Classes="InfoCard">
                    <StackPanel Spacing="12">
                        <TextBlock Text="🎬 视频预览" Classes="SectionHeader"/>

                        <ListBox x:Name="LstBdavFiles"
                                 Background="Transparent"
                                 MinHeight="100" MaxHeight="260">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="{Binding FileName}"
                                                       Foreground="#E8F0FE" FontSize="12"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding FilePath}"
                                                       Foreground="#5A7A9A" FontSize="10"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding SizeText}"
                                                   Foreground="#8EAFC8" FontSize="12"
                                                   VerticalAlignment="Center" Margin="8,0"/>
                                        <Button Grid.Column="2" Content="▶" FontSize="12"
                                                Classes="ActionBtn" Padding="6,4"
                                                Click="OnPreviewBdavFileClick"
                                                Tag="{Binding FilePath}"
                                                ToolTip.Tip="预览此文件"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Player Controls -->
                        <Border Classes="InfoCard">
                            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                                <Button x:Name="BtnBdavPlayPause" Content="▶ 播放"
                                        Classes="ActionBtn" Grid.Column="0"
                                        Click="OnBdavPlayPauseClick"
                                        ToolTip.Tip="播放或暂停选中的视频"/>
                                <Button Content="⏹ 停止" Classes="ActionBtn"
                                        Grid.Column="1" Margin="6,0,0,0"
                                        Click="OnBdavStopClick"
                                        ToolTip.Tip="停止播放"/>
                                <TextBlock x:Name="TxtBdavNowPlaying"
                                           Text="未选择文件"
                                           Foreground="#5A7A9A" FontSize="11"
                                           VerticalAlignment="Center"
                                           Grid.Column="2" Margin="12,0,0,0"/>
                                <Slider x:Name="SliderBdavPosition"
                                        Grid.Column="3" Minimum="0" Maximum="100"
                                        Margin="12,0" VerticalAlignment="Center"
                                        IsEnabled="False"
                                        ToolTip.Tip="播放位置"/>
                                <TextBlock x:Name="TxtBdavPlaybackTime"
                                           Text="00:00 / 00:00" Foreground="#8EAFC8"
                                           FontSize="11" Grid.Column="4"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Burn Settings -->
                <Border Classes="Card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="🔥 刻录设置" Classes="SectionHeader"/>
                        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto">
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4" Margin="0,0,8,8">
                                <TextBlock Text="目标光驱" Classes="FieldLabel"/>
                                <ComboBox x:Name="CmbBdavDrive" HorizontalAlignment="Stretch"
                                          ToolTip.Tip="选择刻录机"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4" Margin="0,0,8,8">
                                <TextBlock Text="写入速度" Classes="FieldLabel"/>
                                <ComboBox x:Name="CmbBdavSpeed" HorizontalAlignment="Stretch"
                                          ToolTip.Tip="刻录的写入速度">
                                    <ComboBoxItem Content="Auto" IsSelected="True"/>
                                    <ComboBoxItem Content="1x"/>
                                    <ComboBoxItem Content="2x"/>
                                    <ComboBoxItem Content="4x"/>
                                    <ComboBoxItem Content="6x"/>
                                    <ComboBoxItem Content="8x"/>
                                    <ComboBoxItem Content="12x"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4" Margin="0,0,0,8">
                                <TextBlock Text="份数" Classes="FieldLabel"/>
                                <NumericUpDown x:Name="NumBdavCopies" Minimum="1" Maximum="99"
                                               Value="1" FormatString="0"
                                               ToolTip.Tip="要刻录的光盘份数"/>
                            </StackPanel>
                        </Grid>
                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <CheckBox x:Name="ChkBdavEject" Content="刻录后弹出"
                                      IsChecked="True" Margin="0,0,16,6"
                                      ToolTip.Tip="刻录完成时弹出光盘"/>
                            <CheckBox x:Name="ChkBdavVerify" Content="刻录后校验"
                                      Margin="0,0,16,6"
                                      ToolTip.Tip="刻录后校验光盘完整性"/>
                            <CheckBox x:Name="ChkBdavSimulate" Content="模拟（测试写入）"
                                      Margin="0,0,16,6"
                                      ToolTip.Tip="模拟刻录而不实际写入光盘"/>
                            <CheckBox x:Name="ChkBdavBup" Content="缓存欠载保护"
                                      IsChecked="True" Margin="0,0,16,6"
                                      ToolTip.Tip="防止刻录过程中出现缓存欠载错误"/>
                            <CheckBox x:Name="ChkBdavBurnDisc"
                                      Content="同时刻录到光盘（不仅构建镜像）"
                                      IsChecked="True" Margin="0,0,16,6"
                                      ToolTip.Tip="取消勾选则仅创建 ISO 镜像而不刻录"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============================================================ -->
            <!-- STEP 2F: 3D Blu-ray from Folder                             -->
            <!-- ============================================================ -->
            <StackPanel x:Name="Step2Bd3dPanel" IsVisible="False" Spacing="16">
                <TextBlock Text="从文件夹创建 3D 蓝光 — 配置并刻录" Classes="SectionHeader"/>

                <!-- Source BDMV 3D Folder -->
                <Border Classes="Card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="📂 源 BDMV 3D 文件夹" Classes="SectionHeader"/>
                        <TextBlock Text="选择包含 3D 内容的 BDMV 文件夹（内含 STREAM、CLIPINF、PLAYLIST 和 SSIF 文件夹）。"
                                   Foreground="#5A7A9A" FontSize="11"/>
                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                            <TextBox x:Name="TxtBd3dSourceFolder"
                                     Watermark="BDMV 3D 文件夹路径…"
                                     Grid.Column="0"/>
                            <Button Content="📂 浏览" Classes="ActionBtn"
                                    Grid.Column="1" Margin="8,0,0,0"
                                    Click="OnBrowseBd3dSourceClick"
                                    ToolTip.Tip="浏览并选择 BDMV 3D 文件夹"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 3D Blu-ray Settings -->
                <Border Classes="Card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="🎥 3D 蓝光设置" Classes="SectionHeader"/>
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4" Margin="0,0,8,8">
                                <TextBlock Text="卷标" Classes="FieldLabel"/>
                                <TextBox x:Name="TxtBd3dVolumeLabel" Watermark="BLURAY3D_DISC"
                                         MaxLength="32"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4" Margin="0,0,0,8">
                                <TextBlock Text="光盘容量" Classes="FieldLabel"/>
                                <ComboBox x:Name="CmbBd3dDiscSize" HorizontalAlignment="Stretch"
                                          ToolTip.Tip="3D 蓝光的目标光盘容量">
                                    <ComboBoxItem Content="BD-50 (50 GB)" IsSelected="True"/>
                                    <ComboBoxItem Content="BD-25 (25 GB)"/>
                                    <ComboBoxItem Content="BD-100 (BDXL 100 GB)"/>
                                    <ComboBoxItem Content="BD-128 (BDXL 128 GB)"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4" Margin="0,0,8,8">
                                <TextBlock Text="3D 模式" Classes="FieldLabel"/>
                                <ComboBox x:Name="CmbBd3dMode" HorizontalAlignment="Stretch"
                                          ToolTip.Tip="按照蓝光 3D Profile 5.0 的立体 3D 编码模式">
                                    <ComboBoxItem Content="Frame Packed (MVC, full resolution)" IsSelected="True"/>
                                    <ComboBoxItem Content="Side by Side (half horizontal)"/>
                                    <ComboBoxItem Content="Top and Bottom (half vertical)"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4" Margin="0,0,0,8">
                                <TextBlock Text="3D 深度偏移" Classes="FieldLabel"/>
                                <NumericUpDown x:Name="NumBd3dDepthOffset" Minimum="-2048" Maximum="2047"
                                               Value="0" FormatString="0"
                                               ToolTip.Tip="以 1/10 像素为单位的会聚距离。0 = 屏幕深度；正值 = 屏幕之后，负值 = 屏幕之前。"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Dependent View (right eye) for Frame Packed mode -->
                <Border x:Name="Bd3dDependentViewCard" Classes="Card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="👁 从属视图（右眼）— 帧封装模式" Classes="SectionHeader"/>
                        <TextBlock Text="帧封装（MVC）3D 需要提供从属视图（右眼）视频文件。左右并排 / 上下模式则在基础视图中编码 3D 内容。"
                                   Foreground="#5A7A9A" FontSize="11" TextWrapping="Wrap"/>
                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                            <TextBox x:Name="TxtBd3dDependentViewPath"
                                     Watermark="右眼（从属视图）视频路径…"
                                     Grid.Column="0"/>
                            <Button Content="📂 浏览" Classes="ActionBtn"
                                    Grid.Column="1" Margin="8,0,0,0"
                                    Click="OnBrowseBd3dDependentViewClick"
                                    ToolTip.Tip="浏览并选择从属视图（右眼）视频文件"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Output Image Path -->
                <Border Classes="Card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="💾 输出镜像" Classes="SectionHeader"/>
                        <TextBlock Text="3D 蓝光镜像（ISO）将保存到此位置。"
                                   Foreground="#5A7A9A" FontSize="11"/>
                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                            <TextBox x:Name="TxtBd3dOutputPath"
                                     Watermark="3D 蓝光镜像的保存路径…"
                                     Grid.Column="0"/>
                            <Button Content="📂 浏览" Classes="ActionBtn"
                                    Grid.Column="1" Margin="8,0,0,0"
                                    Click="OnBrowseBd3dOutputClick"
                                    ToolTip.Tip="选择输出 3D 蓝光镜像的保存位置"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Video Preview -->
                <Border Classes="InfoCard">
                    <StackPanel Spacing="12">
                        <TextBlock Text="🎬 视频预览" Classes="SectionHeader"/>

                        <ListBox x:Name="LstBd3dFiles"
                                 Background="Transparent"
                                 MinHeight="100" MaxHeight="260">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="{Binding FileName}"
                                                       Foreground="#E8F0FE" FontSize="12"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding FilePath}"
                                                       Foreground="#5A7A9A" FontSize="10"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding SizeText}"
                                                   Foreground="#8EAFC8" FontSize="12"
                                                   VerticalAlignment="Center" Margin="8,0"/>
                                        <Button Grid.Column="2" Content="▶" FontSize="12"
                                                Classes="ActionBtn" Padding="6,4"
                                                Click="OnPreviewBd3dFileClick"
                                                Tag="{Binding FilePath}"
                                                ToolTip.Tip="预览此文件"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Player Controls -->
                        <Border Classes="InfoCard">
                            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                                <Button x:Name="BtnBd3dPlayPause" Content="▶ 播放"
                                        Classes="ActionBtn" Grid.Column="0"
                                        Click="OnBd3dPlayPauseClick"
                                        ToolTip.Tip="播放或暂停选中的视频"/>
                                <Button Content="⏹ 停止" Classes="ActionBtn"
                                        Grid.Column="1" Margin="6,0,0,0"
                                        Click="OnBd3dStopClick"
                                        ToolTip.Tip="停止播放"/>
                                <TextBlock x:Name="TxtBd3dNowPlaying"
                                           Text="未选择文件"
                                           Foreground="#5A7A9A" FontSize="11"
                                           VerticalAlignment="Center"
                                           Grid.Column="2" Margin="12,0,0,0"/>
                                <Slider x:Name="SliderBd3dPosition"
                                        Grid.Column="3" Minimum="0" Maximum="100"
                                        Margin="12,0" VerticalAlignment="Center"
                                        IsEnabled="False"
                                        ToolTip.Tip="播放位置"/>
                                <TextBlock x:Name="TxtBd3dPlaybackTime"
                                           Text="00:00 / 00:00" Foreground="#8EAFC8"
                                           FontSize="11" Grid.Column="4"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Burn Settings -->
                <Border Classes="Card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="🔥 刻录设置" Classes="SectionHeader"/>
                        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto">
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4" Margin="0,0,8,8">
                                <TextBlock Text="目标光驱" Classes="FieldLabel"/>
                                <ComboBox x:Name="CmbBd3dDrive" HorizontalAlignment="Stretch"
                                          ToolTip.Tip="选择刻录机"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4" Margin="0,0,8,8">
                                <TextBlock Text="写入速度" Classes="FieldLabel"/>
                                <ComboBox x:Name="CmbBd3dSpeed" HorizontalAlignment="Stretch"
                                          ToolTip.Tip="刻录的写入速度">
                                    <ComboBoxItem Content="Auto" IsSelected="True"/>
                                    <ComboBoxItem Content="1x"/>
                                    <ComboBoxItem Content="2x"/>
                                    <ComboBoxItem Content="4x"/>
                                    <ComboBoxItem Content="6x"/>
                                    <ComboBoxItem Content="8x"/>
                                    <ComboBoxItem Content="12x"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4" Margin="0,0,0,8">
                                <TextBlock Text="份数" Classes="FieldLabel"/>
                                <NumericUpDown x:Name="NumBd3dCopies" Minimum="1" Maximum="99"
                                               Value="1" FormatString="0"
                                               ToolTip.Tip="要刻录的光盘份数"/>
                            </StackPanel>
                        </Grid>
                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <CheckBox x:Name="ChkBd3dEject" Content="刻录后弹出"
                                      IsChecked="True" Margin="0,0,16,6"
                                      ToolTip.Tip="刻录完成时弹出光盘"/>
                            <CheckBox x:Name="ChkBd3dVerify" Content="刻录后校验"
                                      Margin="0,0,16,6"
                                      ToolTip.Tip="刻录后校验光盘完整性"/>
                            <CheckBox x:Name="ChkBd3dSimulate" Content="模拟（测试写入）"
                                      Margin="0,0,16,6"
                                      ToolTip.Tip="模拟刻录而不实际写入光盘"/>
                            <CheckBox x:Name="ChkBd3dBup" Content="缓存欠载保护"
                                      IsChecked="True" Margin="0,0,16,6"
                                      ToolTip.Tip="防止刻录过程中出现缓存欠载错误"/>
                            <CheckBox x:Name="ChkBd3dBurnDisc"
                                      Content="同时刻录到光盘（不仅构建镜像）"
                                      IsChecked="True" Margin="0,0,16,6"
                                      ToolTip.Tip="取消勾选则仅创建 ISO 镜像而不刻录"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============================================================ -->
            <!-- STEP 2C: Video CD (VCD)                                      -->
            <!-- ============================================================ -->
            <StackPanel x:Name="Step2VcdPanel" IsVisible="False" Spacing="16">
                <TextBlock Text="视频 CD（VCD）— 添加文件并配置" Classes="SectionHeader"/>

                <!-- Video Files -->
                <Border Classes="Card">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="📼 视频文件" Classes="SectionHeader"/>
                            <TextBlock x:Name="TxtVcdFileCount" Text="（0 个文件）"
                                       Foreground="#5A7A9A" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="➕ 添加文件" Classes="PrimaryBtn"
                                    Click="OnAddVcdFilesClick"
                                    ToolTip.Tip="添加 MPEG-1 视频文件"/>
                            <Button Content="🗑 移除所选" Classes="DangerBtn"
                                    Click="OnRemoveVcdFileClick"
                                    ToolTip.Tip="从列表中移除选中的文件"/>
                            <Button Content="⬆" Classes="ActionBtn" Click="OnMoveVcdUpClick"
                                    ToolTip.Tip="上移选中的文件"/>
                            <Button Content="⬇" Classes="ActionBtn" Click="OnMoveVcdDownClick"
                                    ToolTip.Tip="下移选中的文件"/>
                        </StackPanel>

                        <Border Classes="DropZone" DragDrop.AllowDrop="True"
                                DragDrop.DragOver="OnVcdDragOver"
                                DragDrop.Drop="OnVcdDrop">
                            <ListBox x:Name="LstVcdFiles"
                                     Background="Transparent"
                                     MinHeight="100" MaxHeight="260">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding TrackNumber}"
                                                       Foreground="#5A7A9A" FontSize="12"
                                                       VerticalAlignment="Center" Margin="0,0,8,0"
                                                       FontWeight="Bold" Width="24"/>
                                            <StackPanel Grid.Column="1" Spacing="1">
                                                <TextBlock Text="{Binding FileName}"
                                                           Foreground="#E8F0FE" FontSize="12"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding FilePath}"
                                                           Foreground="#5A7A9A" FontSize="10"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding DurationText}"
                                                       Foreground="#8EAFC8" FontSize="12"
                                                       VerticalAlignment="Center" Margin="8,0"/>
                                            <Button Grid.Column="3" Content="▶" FontSize="12"
                                                    Classes="ActionBtn" Padding="6,4"
                                                    Click="OnPreviewVcdFileClick"
                                                    Tag="{Binding FilePath}"
                                                    ToolTip.Tip="预览此文件"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <!-- Video Player -->
                        <Border Classes="InfoCard">
                            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                                <Button x:Name="BtnVcdPlayPause" Content="▶ 播放"
                                        Classes="ActionBtn" Grid.Column="0"
                                        Click="OnVcdPlayPauseClick"
                                        ToolTip.Tip="播放或暂停选中的视频"/>
                                <Button Content="⏹ 停止" Classes="ActionBtn"
                                        Grid.Column="1" Margin="6,0,0,0"
                                        Click="OnVcdStopClick"
                                        ToolTip.Tip="停止播放"/>
                                <TextBlock x:Name="TxtVcdNowPlaying"
                                           Text="未选择文件"
                                           Foreground="#5A7A9A" FontSize="11"
                                           VerticalAlignment="Center"
                                           Grid.Column="2" Margin="12,0,0,0"/>
                                <Slider x:Name="SliderVcdPosition"
                                        Grid.Column="3" Minimum="0" Maximum="100"
                                        Margin="12,0" VerticalAlignment="Center"
                                        IsEnabled="False"
                                        ToolTip.Tip="播放位置"/>
                                <TextBlock x:Name="TxtVcdPlaybackTime"
                                           Text="00:00 / 00:00" Foreground="#8EAFC8"
                                           FontSize="11" Grid.Column="4"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- VCD Settings -->
                <Border Classes="Card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="📼 VCD 设置" Classes="SectionHeader"/>
                        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto">
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                <TextBlock Text="视频制式" Classes="FieldLabel"/>
                                <ComboBox x:Name="CmbVcdVideoStandard" HorizontalAlignment="Stretch"
                                          ToolTip.Tip="VCD 的视频制式">
                                    <ComboBoxItem Content="NTSC" IsSelected="True"/>
                                    <ComboBoxItem Content="PAL"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4" Margin="0,0,8,0">
                                <TextBlock Text="VCD 版本" Classes="FieldLabel"/>
                                <ComboBox x:Name="CmbVcdVersion" HorizontalAlignment="Stretch"
                                          ToolTip.Tip="VCD 规范版本">
                                    <ComboBoxItem Content="2.0 (with PBC)" IsSelected="True"/>
                                    <ComboBoxItem Content="1.1 (basic)"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4" Margin="0,0,0,0">
                                <TextBlock Text="光盘标签" Classes="FieldLabel"/>
                                <TextBox x:Name="TxtVcdDiscLabel" Watermark="VIDEOCD"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Advanced VCD Options -->
                <Expander Classes="SettingsExpander" Header="⚙️ 高级 VCD 选项"
                          IsExpanded="False">
                    <StackPanel Spacing="8" Margin="0,12,0,0">
                        <WrapPanel Orientation="Horizontal">
                            <CheckBox x:Name="ChkVcdPbc"
                                      Content="播放控制（PBC）"
                                      IsChecked="True" Margin="0,0,16,6"
                                      ToolTip.Tip="在 VCD 上启用 PBC 菜单和导航"/>
                            <CheckBox x:Name="ChkVcdScanData"
                                      Content="创建扫描数据"
                                      IsChecked="True" Margin="0,0,16,6"
                                      ToolTip.Tip="包含扫描数据以支持快进/快退"/>
                            <CheckBox x:Name="ChkVcdSearchData"
                                      Content="创建搜索数据"
                                      IsChecked="True" Margin="0,0,16,6"
                                      ToolTip.Tip="包含搜索数据以支持章节定位"/>
                            <CheckBox x:Name="ChkVcdCdi"
                                      Content="包含 CD-i 应用程序"
                                      Margin="0,0,16,6"
                                      ToolTip.Tip="包含用于飞利浦 CD-i 播放机的 CD-i 应用程序"/>
                        </WrapPanel>
                    </StackPanel>
                </Expander>

                <!-- Output Image Path -->
                <Border Classes="Card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="💾 输出镜像" Classes="SectionHeader"/>
                        <TextBlock Text="VCD 镜像（BIN/CUE）将保存到此位置。"
                                   Foreground="#5A7A9A" FontSize="11"/>
                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                            <TextBox x:Name="TxtVcdOutputPath"
                                     Watermark="VCD 镜像的保存路径…"
                                     Grid.Column="0"/>
                            <Button Content="📂 浏览" Classes="ActionBtn"
                                    Grid.Column="1" Margin="8,0,0,0"
                                    Click="OnBrowseVcdOutputClick"
                                    ToolTip.Tip="选择输出 VCD 镜像的保存位置"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Burn Settings -->
                <Border Classes="Card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="🔥 刻录设置" Classes="SectionHeader"/>
                        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto">
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4" Margin="0,0,8,8">
                                <TextBlock Text="目标光驱" Classes="FieldLabel"/>
                                <ComboBox x:Name="CmbVcdDrive" HorizontalAlignment="Stretch"
                                          ToolTip.Tip="选择刻录机"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4" Margin="0,0,8,8">
                                <TextBlock Text="写入速度" Classes="FieldLabel"/>
                                <ComboBox x:Name="CmbVcdSpeed" HorizontalAlignment="Stretch"
                                          ToolTip.Tip="刻录的写入速度">
                                    <ComboBoxItem Content="Auto" IsSelected="True"/>
                                    <ComboBoxItem Content="1x"/>
                                    <ComboBoxItem Content="2x"/>
                                    <ComboBoxItem Content="4x"/>
                                    <ComboBoxItem Content="8x"/>
                                    <ComboBoxItem Content="10x"/>
                                    <ComboBoxItem Content="12x"/>
                                    <ComboBoxItem Content="16x"/>
                                    <ComboBoxItem Content="24x"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4" Margin="0,0,0,8">
                                <TextBlock Text="写入模式" Classes="FieldLabel"/>
                                <ComboBox x:Name="CmbVcdWriteMode" HorizontalAlignment="Stretch"
                                          ToolTip.Tip="VCD 刻录的写入策略">
                                    <ComboBoxItem Content="DAO (Disc At Once)" IsSelected="True"/>
                                    <ComboBoxItem Content="SAO (Session At Once)"/>
                                    <ComboBoxItem Content="TAO (Track At Once)"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                <TextBlock Text="份数" Classes="FieldLabel"/>
                                <NumericUpDown x:Name="NumVcdCopies" Minimum="1" Maximum="99"
                                               Value="1" FormatString="0"
                                               ToolTip.Tip="要刻录的光盘份数"/>
                            </StackPanel>
                        </Grid>
                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <CheckBox x:Name="ChkVcdEject" Content="刻录后弹出"
                                      IsChecked="True" Margin="0,0,16,6"
                                      ToolTip.Tip="刻录完成时弹出光盘"/>
                            <CheckBox x:Name="ChkVcdVerify" Content="刻录后校验"
                                      Margin="0,0,16,6"
                                      ToolTip.Tip="刻录后校验光盘完整性"/>
                            <CheckBox x:Name="ChkVcdSimulate" Content="模拟（测试写入）"
                                      Margin="0,0,16,6"
                                      ToolTip.Tip="模拟刻录而不实际写入光盘"/>
                            <CheckBox x:Name="ChkVcdBup" Content="缓存欠载保护"
                                      IsChecked="True" Margin="0,0,16,6"
                                      ToolTip.Tip="防止刻录过程中出现缓存欠载错误"/>
                            <CheckBox x:Name="ChkVcdBurnDisc"
                                      Content="同时刻录到光盘（不仅构建镜像）"
                                      IsChecked="True" Margin="0,0,16,6"
                                      ToolTip.Tip="取消勾选则仅创建 BIN/CUE 镜像而不刻录"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============================================================ -->
            <!-- STEP 2D: Super Video CD (SVCD)                               -->
            <!-- ============================================================ -->
            <StackPanel x:Name="Step2SvcdPanel" IsVisible="False" Spacing="16">
                <TextBlock Text="超级视频 CD（SVCD）— 添加文件并配置" Classes="SectionHeader"/>

                <!-- Video Files -->
                <Border Classes="Card">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="📼 视频文件" Classes="SectionHeader"/>
                            <TextBlock x:Name="TxtSvcdFileCount" Text="（0 个文件）"
                                       Foreground="#5A7A9A" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="➕ 添加文件" Classes="PrimaryBtn"
                                    Click="OnAddSvcdFilesClick"
                                    ToolTip.Tip="添加 MPEG-2 视频文件"/>
                            <Button Content="🗑 移除所选" Classes="DangerBtn"
                                    Click="OnRemoveSvcdFileClick"
                                    ToolTip.Tip="从列表中移除选中的文件"/>
                            <Button Content="⬆" Classes="ActionBtn" Click="OnMoveSvcdUpClick"
                                    ToolTip.Tip="上移选中的文件"/>
                            <Button Content="⬇" Classes="ActionBtn" Click="OnMoveSvcdDownClick"
                                    ToolTip.Tip="下移选中的文件"/>
                        </StackPanel>

                        <Border Classes="DropZone" DragDrop.AllowDrop="True"
                                DragDrop.DragOver="OnSvcdDragOver"
                                DragDrop.Drop="OnSvcdDrop">
                            <ListBox x:Name="LstSvcdFiles"
                                     Background="Transparent"
                                     MinHeight="100" MaxHeight="260">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding TrackNumber}"
                                                       Foreground="#5A7A9A" FontSize="12"
                                                       VerticalAlignment="Center" Margin="0,0,8,0"
                                                       FontWeight="Bold" Width="24"/>
                                            <StackPanel Grid.Column="1" Spacing="1">
                                                <TextBlock Text="{Binding FileName}"
                                                           Foreground="#E8F0FE" FontSize="12"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding FilePath}"
                                                           Foreground="#5A7A9A" FontSize="10"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding DurationText}"
                                                       Foreground="#8EAFC8" FontSize="12"
                                                       VerticalAlignment="Center" Margin="8,0"/>
                                            <Button Grid.Column="3" Content="▶" FontSize="12"
                                                    Classes="ActionBtn" Padding="6,4"
                                                    Click="OnPreviewSvcdFileClick"
                                                    Tag="{Binding FilePath}"
                                                    ToolTip.Tip="预览此文件"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <!-- Video Player -->
                        <Border Classes="InfoCard">
                            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                                <Button x:Name="BtnSvcdPlayPause" Content="▶ 播放"
                                        Classes="ActionBtn" Grid.Column="0"
                                        Click="OnSvcdPlayPauseClick"
                                        ToolTip.Tip="播放或暂停选中的视频"/>
                                <Button Content="⏹ 停止" Classes="ActionBtn"
                                        Grid.Column="1" Margin="6,0,0,0"
                                        Click="OnSvcdStopClick"
                                        ToolTip.Tip="停止播放"/>
                                <TextBlock x:Name="TxtSvcdNowPlaying"
                                           Text="未选择文件"
                                           Foreground="#5A7A9A" FontSize="11"
                                           VerticalAlignment="Center"
                                           Grid.Column="2" Margin="12,0,0,0"/>
                                <Slider x:Name="SliderSvcdPosition"
                                        Grid.Column="3" Minimum="0" Maximum="100"
                                        Margin="12,0" VerticalAlignment="Center"
                                        IsEnabled="False"
                                        ToolTip.Tip="播放位置"/>
                                <TextBlock x:Name="TxtSvcdPlaybackTime"
                                           Text="00:00 / 00:00" Foreground="#8EAFC8"
                                           FontSize="11" Grid.Column="4"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- SVCD Settings -->
                <Border Classes="Card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="📼 SVCD 设置" Classes="SectionHeader"/>
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto">
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                <TextBlock Text="视频制式" Classes="FieldLabel"/>
                                <ComboBox x:Name="CmbSvcdVideoStandard" HorizontalAlignment="Stretch"
                                          ToolTip.Tip="SVCD 的视频制式">
                                    <ComboBoxItem Content="NTSC" IsSelected="True"/>
                                    <ComboBoxItem Content="PAL"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4" Margin="0,0,0,0">
                                <TextBlock Text="光盘标签" Classes="FieldLabel"/>
                                <TextBox x:Name="TxtSvcdDiscLabel" Watermark="SUPERVCD"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Advanced SVCD Options -->
                <Expander Classes="SettingsExpander" Header="⚙️ 高级 SVCD 选项"
                          IsExpanded="False">
                    <StackPanel Spacing="8" Margin="0,12,0,0">
                        <WrapPanel Orientation="Horizontal">
                            <CheckBox x:Name="ChkSvcdPbc"
                                      Content="播放控制（PBC）"
                                      IsChecked="True" Margin="0,0,16,6"
                                      ToolTip.Tip="在 SVCD 上启用 PBC 菜单和导航"/>
                            <CheckBox x:Name="ChkSvcdScanData"
                                      Content="创建扫描数据"
                                      IsChecked="True" Margin="0,0,16,6"
                                      ToolTip.Tip="包含扫描数据以支持快进/快退"/>
                            <CheckBox x:Name="ChkSvcdSearchData"
                                      Content="创建搜索数据"
                                      IsChecked="True" Margin="0,0,16,6"
                                      ToolTip.Tip="包含搜索数据以支持章节定位"/>
                        </WrapPanel>
                    </StackPanel>
                </Expander>

                <!-- Output Image Path -->
                <Border Classes="Card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="💾 输出镜像" Classes="SectionHeader"/>
                        <TextBlock Text="SVCD 镜像（BIN/CUE）将保存到此位置。"
                                   Foreground="#5A7A9A" FontSize="11"/>
                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                            <TextBox x:Name="TxtSvcdOutputPath"
                                     Watermark="SVCD 镜像的保存路径…"
                                     Grid.Column="0"/>
                            <Button Content="📂 浏览" Classes="ActionBtn"
                                    Grid.Column="1" Margin="8,0,0,0"
                                    Click="OnBrowseSvcdOutputClick"
                                    ToolTip.Tip="选择输出 SVCD 镜像的保存位置"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Burn Settings -->
                <Border Classes="Card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="🔥 刻录设置" Classes="SectionHeader"/>
                        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto">
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4" Margin="0,0,8,8">
                                <TextBlock Text="目标光驱" Classes="FieldLabel"/>
                                <ComboBox x:Name="CmbSvcdDrive" HorizontalAlignment="Stretch"
                                          ToolTip.Tip="选择刻录机"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4" Margin="0,0,8,8">
                                <TextBlock Text="写入速度" Classes="FieldLabel"/>
                                <ComboBox x:Name="CmbSvcdSpeed" HorizontalAlignment="Stretch"
                                          ToolTip.Tip="刻录的写入速度">
                                    <ComboBoxItem Content="Auto" IsSelected="True"/>
                                    <ComboBoxItem Content="1x"/>
                                    <ComboBoxItem Content="2x"/>
                                    <ComboBoxItem Content="4x"/>
                                    <ComboBoxItem Content="8x"/>
                                    <ComboBoxItem Content="10x"/>
                                    <ComboBoxItem Content="12x"/>
                                    <ComboBoxItem Content="16x"/>
                                    <ComboBoxItem Content="24x"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4" Margin="0,0,0,8">
                                <TextBlock Text="写入模式" Classes="FieldLabel"/>
                                <ComboBox x:Name="CmbSvcdWriteMode" HorizontalAlignment="Stretch"
                                          ToolTip.Tip="SVCD 刻录的写入策略">
                                    <ComboBoxItem Content="DAO (Disc At Once)" IsSelected="True"/>
                                    <ComboBoxItem Content="SAO (Session At Once)"/>
                                    <ComboBoxItem Content="TAO (Track At Once)"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                <TextBlock Text="份数" Classes="FieldLabel"/>
                                <NumericUpDown x:Name="NumSvcdCopies" Minimum="1" Maximum="99"
                                               Value="1" FormatString="0"
                                               ToolTip.Tip="要刻录的光盘份数"/>
                            </StackPanel>
                        </Grid>
                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <CheckBox x:Name="ChkSvcdEject" Content="刻录后弹出"
                                      IsChecked="True" Margin="0,0,16,6"
                                      ToolTip.Tip="刻录完成时弹出光盘"/>
                            <CheckBox x:Name="ChkSvcdVerify" Content="刻录后校验"
                                      Margin="0,0,16,6"
                                      ToolTip.Tip="刻录后校验光盘完整性"/>
                            <CheckBox x:Name="ChkSvcdSimulate" Content="模拟（测试写入）"
                                      Margin="0,0,16,6"
                                      ToolTip.Tip="模拟刻录而不实际写入光盘"/>
                            <CheckBox x:Name="ChkSvcdBup" Content="缓存欠载保护"
                                      IsChecked="True" Margin="0,0,16,6"
                                      ToolTip.Tip="防止刻录过程中出现缓存欠载错误"/>
                            <CheckBox x:Name="ChkSvcdBurnDisc"
                                      Content="同时刻录到光盘（不仅构建镜像）"
                                      IsChecked="True" Margin="0,0,16,6"
                                      ToolTip.Tip="取消勾选则仅创建 BIN/CUE 镜像而不刻录"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============================================================ -->
            <!-- STEP 2G: UHD Blu-ray from Folder                            -->
            <!-- ============================================================ -->
            <StackPanel x:Name="Step2UhdBdPanel" IsVisible="False" Spacing="16">
                <TextBlock Text="从文件夹创建 UHD 蓝光（4K HDR）— 配置并刻录" Classes="SectionHeader"/>

                <!-- Source Folder -->
                <Border Classes="Card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="📂 源文件夹（BDMV）" Classes="SectionHeader"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="TxtUhdBdSourceFolder" Watermark="BDMV 文件夹路径…"
                                     Width="520"/>
                            <Button Content="📁 浏览…" Classes="PrimaryBtn"
                                    Click="OnBrowseUhdBdSourceClick"
                                    ToolTip.Tip="选择 BDMV 源文件夹"/>
                        </StackPanel>

                        <!-- Files list -->
                        <ListBox x:Name="LstUhdBdFiles"
                                 Background="Transparent"
                                 MinHeight="100" MaxHeight="260">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="1">
                                            <TextBlock Text="{Binding FileName}"
                                                       Foreground="#E8F0FE" FontSize="12"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding FilePath}"
                                                       Foreground="#5A7A9A" FontSize="10"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding SizeText}"
                                                   Foreground="#8EAFC8" FontSize="12"
                                                   VerticalAlignment="Center" Margin="8,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- UHD BD Settings -->
                <Border Classes="Card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="⚙️ UHD BD 设置" Classes="SectionHeader"/>
                        <WrapPanel Orientation="Horizontal">
                            <StackPanel Spacing="4" Margin="0,0,16,8">
                                <TextBlock Text="卷标" Foreground="#8EAFC8" FontSize="11"/>
                                <TextBox x:Name="TxtUhdBdVolumeLabel" Watermark="UHD_BLURAY" Width="180"/>
                            </StackPanel>
                            <StackPanel Spacing="4" Margin="0,0,16,8">
                                <TextBlock Text="光盘容量" Foreground="#8EAFC8" FontSize="11"/>
                                <ComboBox x:Name="CmbUhdBdDiscSize" Width="200" SelectedIndex="0">
                                    <ComboBoxItem Content="UHD BD-66 (66 GB)"/>
                                    <ComboBoxItem Content="UHD BD-100 (100 GB)"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Spacing="4" Margin="0,0,16,8">
                                <TextBlock Text="HDR 模式" Foreground="#8EAFC8" FontSize="11"/>
                                <ComboBox x:Name="CmbUhdBdHdrMode" Width="200" SelectedIndex="0">
                                    <ComboBoxItem Content="HDR10"/>
                                    <ComboBoxItem Content="Dolby Vision"/>
                                    <ComboBoxItem Content="HDR10+"/>
                                    <ComboBoxItem Content="HLG"/>
                                </ComboBox>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Output & Burning -->
                <Border Classes="Card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="💾 输出与刻录" Classes="SectionHeader"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="TxtUhdBdOutputPath" Watermark="输出 ISO 镜像路径…"
                                     Width="520"/>
                            <Button Content="📁 浏览…" Classes="PrimaryBtn"
                                    Click="OnBrowseUhdBdOutputClick"
                                    ToolTip.Tip="选择输出 ISO 镜像路径"/>
                        </StackPanel>

                        <WrapPanel Orientation="Horizontal">
                            <CheckBox x:Name="ChkUhdBdBurnDisc" Content="🔥 刻录到光盘" Margin="0,0,16,8"
                                      ToolTip.Tip="创建后刻录 UHD 蓝光 ISO 镜像"/>
                            <CheckBox x:Name="ChkUhdBdEject" Content="⏏️ 完成后弹出" Margin="0,0,16,8"/>
                            <CheckBox x:Name="ChkUhdBdVerify" Content="✅ 完成后校验" Margin="0,0,16,8"/>
                            <CheckBox x:Name="ChkUhdBdSimulate" Content="🧪 模拟" Margin="0,0,16,8"/>
                            <CheckBox x:Name="ChkUhdBdBup" Content="🛡 缓存欠载保护"
                                      Margin="0,0,16,8" IsChecked="True"/>
                        </WrapPanel>

                        <WrapPanel Orientation="Horizontal">
                            <StackPanel Spacing="4" Margin="0,0,16,8">
                                <TextBlock Text="目标光驱" Foreground="#8EAFC8" FontSize="11"/>
                                <ComboBox x:Name="CmbUhdBdDrive" Width="260"/>
                            </StackPanel>
                            <StackPanel Spacing="4" Margin="0,0,16,8">
                                <TextBlock Text="写入速度" Foreground="#8EAFC8" FontSize="11"/>
                                <ComboBox x:Name="CmbUhdBdSpeed" Width="120" SelectedIndex="0">
                                    <ComboBoxItem Content="Auto"/>
                                    <ComboBoxItem Content="2x"/>
                                    <ComboBoxItem Content="4x"/>
                                    <ComboBoxItem Content="6x"/>
                                    <ComboBoxItem Content="8x"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Spacing="4" Margin="0,0,16,8">
                                <TextBlock Text="份数" Foreground="#8EAFC8" FontSize="11"/>
                                <NumericUpDown x:Name="NumUhdBdCopies" Minimum="1" Maximum="99" Value="1"
                                               Width="80"/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============================================================ -->
            <!-- STEP 2H: XSVCD (eXtended Super Video CD)                    -->
            <!-- ============================================================ -->
            <StackPanel x:Name="Step2XsvcdPanel" IsVisible="False" Spacing="16">
                <TextBlock Text="扩展超级视频 CD（XSVCD）— 添加文件并配置" Classes="SectionHeader"/>

                <!-- Video Files -->
                <Border Classes="Card">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="📼 视频文件" Classes="SectionHeader"/>
                            <TextBlock x:Name="TxtXsvcdFileCount" Text="（0 个文件）"
                                       Foreground="#5A7A9A" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="➕ 添加文件" Classes="PrimaryBtn"
                                    Click="OnAddXsvcdFilesClick"
                                    ToolTip.Tip="添加 MPEG-2 视频文件"/>
                            <Button Content="🗑 移除所选" Classes="DangerBtn"
                                    Click="OnRemoveXsvcdFileClick"
                                    ToolTip.Tip="从列表中移除选中的文件"/>
                            <Button Content="⬆" Classes="ActionBtn" Click="OnMoveXsvcdUpClick"
                                    ToolTip.Tip="上移选中的文件"/>
                            <Button Content="⬇" Classes="ActionBtn" Click="OnMoveXsvcdDownClick"
                                    ToolTip.Tip="下移选中的文件"/>
                        </StackPanel>

                        <Border Classes="DropZone" DragDrop.AllowDrop="True"
                                DragDrop.DragOver="OnXsvcdDragOver"
                                DragDrop.Drop="OnXsvcdDrop">
                            <ListBox x:Name="LstXsvcdFiles"
                                     Background="Transparent"
                                     MinHeight="100" MaxHeight="260">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding TrackNumber}"
                                                       Foreground="#5A7A9A" FontSize="12"
                                                       VerticalAlignment="Center" Margin="0,0,8,0"
                                                       FontWeight="Bold" Width="24"/>
                                            <StackPanel Grid.Column="1" Spacing="1">
                                                <TextBlock Text="{Binding FileName}"
                                                           Foreground="#E8F0FE" FontSize="12"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding FilePath}"
                                                           Foreground="#5A7A9A" FontSize="10"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding DurationText}"
                                                       Foreground="#8EAFC8" FontSize="12"
                                                       VerticalAlignment="Center" Margin="8,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- XSVCD Settings -->
                <Border Classes="Card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="⚙️ XSVCD 设置" Classes="SectionHeader"/>
                        <WrapPanel Orientation="Horizontal">
                            <StackPanel Spacing="4" Margin="0,0,16,8">
                                <TextBlock Text="视频制式" Foreground="#8EAFC8" FontSize="11"/>
                                <ComboBox x:Name="CmbXsvcdVideoStandard" Width="120" SelectedIndex="0">
                                    <ComboBoxItem Content="NTSC"/>
                                    <ComboBoxItem Content="PAL"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Spacing="4" Margin="0,0,16,8">
                                <TextBlock Text="光盘标签" Foreground="#8EAFC8" FontSize="11"/>
                                <TextBox x:Name="TxtXsvcdDiscLabel" Watermark="XSVCD" Width="180"/>
                            </StackPanel>
                        </WrapPanel>
                        <WrapPanel Orientation="Horizontal">
                            <CheckBox x:Name="ChkXsvcdPbc" Content="🎮 播放控制（PBC）"
                                      Margin="0,0,16,8" IsChecked="True"
                                      ToolTip.Tip="启用交互式导航菜单"/>
                            <CheckBox x:Name="ChkXsvcdScanData" Content="📡 扫描数据"
                                      Margin="0,0,16,8" IsChecked="True"
                                      ToolTip.Tip="包含 SCANDATA.DAT 以支持快进/快退"/>
                            <CheckBox x:Name="ChkXsvcdSearchData" Content="🔍 搜索数据"
                                      Margin="0,0,16,8" IsChecked="True"
                                      ToolTip.Tip="包含 SEARCH.DAT 以支持章节/轨道定位"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Output & Burning -->
                <Border Classes="Card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="💾 输出与刻录" Classes="SectionHeader"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="TxtXsvcdOutputPath" Watermark="输出镜像路径（.bin）…"
                                     Width="520"/>
                            <Button Content="📁 浏览…" Classes="PrimaryBtn"
                                    Click="OnBrowseXsvcdOutputClick"
                                    ToolTip.Tip="选择输出 BIN/CUE 镜像路径"/>
                        </StackPanel>

                        <WrapPanel Orientation="Horizontal">
                            <CheckBox x:Name="ChkXsvcdBurnDisc" Content="🔥 刻录到光盘" Margin="0,0,16,8"
                                      ToolTip.Tip="创建后刻录 XSVCD 镜像"/>
                            <CheckBox x:Name="ChkXsvcdEject" Content="⏏️ 完成后弹出" Margin="0,0,16,8"/>
                            <CheckBox x:Name="ChkXsvcdVerify" Content="✅ 完成后校验" Margin="0,0,16,8"/>
                            <CheckBox x:Name="ChkXsvcdSimulate" Content="🧪 模拟" Margin="0,0,16,8"/>
                            <CheckBox x:Name="ChkXsvcdBup" Content="🛡 缓存欠载保护"
                                      Margin="0,0,16,8" IsChecked="True"/>
                        </WrapPanel>

                        <WrapPanel Orientation="Horizontal">
                            <StackPanel Spacing="4" Margin="0,0,16,8">
                                <TextBlock Text="目标光驱" Foreground="#8EAFC8" FontSize="11"/>
                                <ComboBox x:Name="CmbXsvcdDrive" Width="260"/>
                            </StackPanel>
                            <StackPanel Spacing="4" Margin="0,0,16,8">
                                <TextBlock Text="写入速度" Foreground="#8EAFC8" FontSize="11"/>
                                <ComboBox x:Name="CmbXsvcdSpeed" Width="120" SelectedIndex="0">
                                    <ComboBoxItem Content="Auto"/>
                                    <ComboBoxItem Content="1x"/>
                                    <ComboBoxItem Content="2x"/>
                                    <ComboBoxItem Content="4x"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Spacing="4" Margin="0,0,16,8">
                                <TextBlock Text="写入模式" Foreground="#8EAFC8" FontSize="11"/>
                                <ComboBox x:Name="CmbXsvcdWriteMode" Width="200" SelectedIndex="0">
                                    <ComboBoxItem Content="DAO (Disc At Once)"/>
                                    <ComboBoxItem Content="TAO (Track At Once)"/>
                                    <ComboBoxItem Content="SAO (Session At Once)"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Spacing="4" Margin="0,0,16,8">
                                <TextBlock Text="份数" Foreground="#8EAFC8" FontSize="11"/>
                                <NumericUpDown x:Name="NumXsvcdCopies" Minimum="1" Maximum="99" Value="1"
                                               Width="80"/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============================================================ -->
            <!-- STEP 3: Summary                                              -->
            <!-- ============================================================ -->
            <StackPanel x:Name="Step3Panel" IsVisible="False" Spacing="16">
                <TextBlock Text="摘要 — 执行前确认" Classes="SectionHeader"/>

                <Border Classes="Card">
                    <StackPanel x:Name="VideoSummaryContent" Spacing="8">
                        <!-- Filled dynamically -->
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============================================================ -->
            <!-- STEP 4: Progress                                             -->
            <!-- ============================================================ -->
            <StackPanel x:Name="Step4Panel" IsVisible="False" Spacing="16">
                <TextBlock x:Name="TxtVideoStep4Title" Text="正在执行…" Classes="SectionHeader"/>

                <Border Classes="Card">
                    <StackPanel Spacing="12">
                        <ProgressBar x:Name="PrgVideoExec" Classes="BurnProgress" Value="0"/>
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                            <TextBlock x:Name="TxtVideoExecStatus" Text="正在准备…"
                                       Foreground="#8EAFC8" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtVideoExecETA" Text=""
                                       Foreground="#5A7A9A" FontSize="11"
                                       Grid.Column="1" VerticalAlignment="Center"
                                       Margin="12,0"/>
                            <TextBlock x:Name="TxtVideoExecSpeed" Text=""
                                       Foreground="#5A7A9A" FontSize="11"
                                       Grid.Column="2" VerticalAlignment="Center"
                                       Margin="12,0"/>
                            <TextBlock x:Name="TxtVideoExecPercent" Text="0%"
                                       Foreground="#E8F0FE" FontSize="13"
                                       FontWeight="SemiBold"
                                       Grid.Column="3" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBox x:Name="TxtVideoExecLog" Classes="LogBox" Height="200"/>
                        <!-- Disc Visualization -->
                        <Border x:Name="DiscVizBorder" Background="#0A1520" CornerRadius="8"
                                Padding="8" IsVisible="False" Margin="0,8,0,0">
                            <views:DiscVisualizationControl x:Name="DiscViz" Height="200"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============================================================ -->
            <!-- Navigation Buttons                                           -->
            <!-- ============================================================ -->
            <Border Classes="InfoCard" Margin="0,8,0,0">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <Button x:Name="BtnVideoBack" Content="← 上一步"
                            Classes="ActionBtn" Click="OnVideoBackClick"
                            IsVisible="False"
                            ToolTip.Tip="返回上一步"/>
                    <Button x:Name="BtnVideoNext" Content="下一步 →"
                            Classes="PrimaryBtn" Grid.Column="2"
                            Click="OnVideoNextClick" IsVisible="False"
                            ToolTip.Tip="进入下一步"/>
                    <Button x:Name="BtnVideoExecute" Content="🔥 开始"
                            Classes="PrimaryBtn" Grid.Column="2"
                            Click="OnVideoExecuteClick" IsVisible="False"
                            ToolTip.Tip="开始操作"/>
                    <Button x:Name="BtnVideoCancel" Content="⏹ 取消"
                            Classes="DangerBtn" Grid.Column="3"
                            Margin="8,0,0,0" Click="OnVideoCancelClick"
                            IsVisible="False"
                            ToolTip.Tip="取消当前操作"/>
                    <Button x:Name="BtnVideoFinish" Content="✅ 完成 — 返回主页"
                            Classes="PrimaryBtn" Grid.Column="2"
                            Click="OnVideoFinishClick" IsVisible="False"
                            ToolTip.Tip="操作完成 — 返回主界面"/>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
