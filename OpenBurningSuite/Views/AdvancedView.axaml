<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OpenBurningSuite.Views.AdvancedView"
             Background="#0C1622">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" Spacing="16">

            <!-- Header -->
            <TextBlock Text="高级工具" Classes="PageTitle"/>
            <TextBlock Text="擦除可重写光盘、格式化介质、弹出/载入托盘以及其他高级光盘操作。"
                       Classes="PageSubtitle"/>

            <!-- Drive selection (shared) -->
            <Border Classes="Card">
                <StackPanel Spacing="8">
                    <TextBlock Text="光驱" Classes="SectionHeader"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <ComboBox x:Name="CmbDrive"
                                  PlaceholderText="选择光驱…"
                                  HorizontalAlignment="Stretch"
                                  ToolTip.Tip="选择要操作的光驱"/>
                        <Button x:Name="BtnRefreshDrives" Grid.Column="1"
                                Content="🔄" Classes="ActionBtn"
                                Margin="6,0,0,0" Click="OnRefreshDrivesClick"
                                ToolTip.Tip="刷新可用光驱列表"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Eject / Load Tray -->
            <Border Classes="Card">
                <StackPanel Spacing="8">
                    <TextBlock Text="弹出 / 载入托盘" Classes="SectionHeader"/>
                    <TextBlock Text="打开或关闭所选光驱的光盘托盘。"
                               Foreground="#5A7A9A" FontSize="11"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button x:Name="BtnEject"
                                Content="⏏️ 弹出托盘" Classes="ActionBtn"
                                Click="OnEjectClick"
                                ToolTip.Tip="打开光盘托盘"/>
                        <Button x:Name="BtnLoadTray"
                                Content="📥 载入托盘" Classes="ActionBtn"
                                Click="OnLoadTrayClick"
                                ToolTip.Tip="关闭光盘托盘"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Blank / Erase -->
            <Border Classes="Card">
                <StackPanel Spacing="8">
                    <TextBlock Text="擦除可重写光盘" Classes="SectionHeader"/>
                    <TextBlock Text="写入前擦除 CD-RW、DVD±RW 或 BD-RE 光盘。"
                               Foreground="#5A7A9A" FontSize="11"/>

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button x:Name="BtnBlankQuick"
                                Content="⚡️ 快速擦除" Classes="ActionBtn"
                                Click="OnBlankQuickClick"
                                ToolTip.Tip="快速擦除仅清除 TOC — 速度快但数据可能被恢复"/>
                        <Button x:Name="BtnBlankFull"
                                Content="🗑  完全擦除" Classes="ActionBtn"
                                Click="OnBlankFullClick"
                                ToolTip.Tip="完全擦除会覆写整张光盘 — 速度较慢但更彻底"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Format Disc -->
            <Border Classes="Card">
                <StackPanel Spacing="8">
                    <TextBlock Text="格式化光盘" Classes="SectionHeader"/>
                    <TextBlock Text="格式化 DVD+RW、DVD-RAM、BD-R、BD-RE 或 HD DVD-RW 光盘。某些介质类型首次使用前必须格式化。"
                               Foreground="#5A7A9A" FontSize="11"/>

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button x:Name="BtnFormatQuick"
                                Content="⚡️ 快速格式化" Classes="ActionBtn"
                                Click="OnFormatQuickClick"
                                ToolTip.Tip="快速格式化 — 使光盘可用，但不进行完整表面认证"/>
                        <Button x:Name="BtnFormatFull"
                                Content="📀 完全格式化" Classes="ActionBtn"
                                Click="OnFormatFullClick"
                                ToolTip.Tip="带认证的完全格式化 — 速度较慢但可确保光盘完整性"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Progress & Log -->
            <Border Classes="Card">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="进度" Classes="SectionHeader"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="BtnCancelOp" Grid.Column="1"
                                Content="⏹  取消" Classes="DangerBtn"
                                IsEnabled="False" Click="OnCancelOpClick"
                                ToolTip.Tip="取消当前操作"/>
                    </Grid>

                    <ProgressBar x:Name="OperationProgressBar" Classes="BurnProgress" Value="0"/>

                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBlock x:Name="TxtOperationStatus" Text="就绪。"
                                   Foreground="#5A7A9A" FontSize="11"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtOperationETA" Grid.Column="1"
                                   Text="" Foreground="#5A7A9A" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock x:Name="TxtOperationPct" Grid.Column="2"
                                   Text="0%" Foreground="#E8F0FE" FontSize="11"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Text="日志" Classes="SectionHeader" VerticalAlignment="Center"/>
                        <Button x:Name="BtnClearLog" Grid.Column="1"
                                Content="🧹 清除" Classes="ActionBtn"
                                HorizontalAlignment="Right" Click="OnClearLogClick"
                                ToolTip.Tip="清除日志输出"/>
                    </Grid>

                    <TextBox x:Name="TxtLog" Classes="LogBox" Height="180"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
