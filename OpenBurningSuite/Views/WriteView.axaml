<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:OpenBurningSuite.Views"
             x:Class="OpenBurningSuite.Views.WriteView"
             Background="#0C1622">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" Spacing="16">

            <!-- Header -->
            <TextBlock Text="写入 / 刻录光盘" Classes="PageTitle"/>
            <TextBlock Text="将光盘镜像写入 CD、DVD、HD DVD 或蓝光光盘，也可即时构建后刻录。"
                       Classes="PageSubtitle"/>

            <!-- Source -->
            <Border Classes="Card">
                <StackPanel Spacing="12">
                    <TextBlock Text="来源" Classes="SectionHeader"/>

                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <RadioButton x:Name="RdoImageFile"
                                     Content="镜像文件" Foreground="#E8F0FE"
                                     IsChecked="True" GroupName="SourceMode"
                                     IsCheckedChanged="OnSourceModeChanged"
                                     ToolTip.Tip="刻录已有的光盘镜像文件"/>
                        <RadioButton x:Name="RdoBuildOnTheFly"
                                     Content="即时构建"
                                     Foreground="#E8F0FE"
                                     GroupName="SourceMode"
                                     IsCheckedChanged="OnSourceModeChanged"
                                     ToolTip.Tip="选择文件和文件夹，直接构建并刻录到光盘，无需先生成独立的镜像文件"/>
                    </StackPanel>

                    <!-- Image File mode panel -->
                    <StackPanel x:Name="PnlImageFile" Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox x:Name="TxtImagePath"
                                     Watermark="镜像文件路径（.iso、.bin、.nrg、.mdf、.cdi、.img）…"
                                     Background="#152030" Foreground="#E8F0FE"
                                     ToolTip.Tip="光盘镜像文件路径（.iso、.bin、.nrg、.mdf、.cdi、.img）"
                                     DragDrop.AllowDrop="True"
                                     DragDrop.DragOver="OnImageDragOver"
                                     DragDrop.Drop="OnImageDrop"/>
                            <Button x:Name="BtnBrowseImage" Grid.Column="1"
                                    Content="浏览…" Classes="ActionBtn"
                                    Margin="6,0,0,0" Click="OnBrowseImageClick"
                                    ToolTip.Tip="浏览并选择光盘镜像文件"/>
                        </Grid>
                        <TextBlock Text="💡 将光盘镜像文件拖放到此处" Foreground="#5A7A9A" FontSize="10" Margin="0,2,0,0"/>
                        <TextBlock x:Name="TxtImageInfo" Text="" Foreground="#5A7A9A" FontSize="10" Margin="0,2,0,0"/>

                        <!-- Encrypted image detection -->
                        <StackPanel x:Name="PnlDecryptImage" IsVisible="False" Spacing="6"
                                    Margin="0,4,0,0">
                            <TextBlock Text="🔒 此镜像已加密（OBS 格式）。请输入密码以便在刻录前解密："
                                       Foreground="#FFB347" FontSize="11" TextWrapping="Wrap"/>
                            <TextBox x:Name="TxtDecryptPassword"
                                     PasswordChar="●"
                                     Watermark="输入解密密码…"
                                     Background="#152030" Foreground="#E8F0FE"
                                     ToolTip.Tip="用于解密已加密光盘镜像的密码"/>
                        </StackPanel>

                        <!-- PS3 encrypted ISO detection -->
                        <Border x:Name="PnlWritePs3Decrypt" IsVisible="False"
                                Background="#1A1520" CornerRadius="6" Padding="12" Margin="0,4,0,0"
                                BorderBrush="#3A2050" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <TextBlock Text="🔐 PS3 ISO 镜像解密" FontSize="13"
                                           Foreground="#BB86FC" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtWritePs3Info" Text=""
                                           Foreground="#FFB347" FontSize="11" TextWrapping="Wrap"/>

                                <!-- Key source selection -->
                                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                                    <RadioButton x:Name="RdoWritePs3Ird" Content="IRD 文件"
                                                 IsChecked="True" Foreground="#E8F0FE"
                                                 GroupName="WritePs3KeySource"
                                                 IsCheckedChanged="OnWritePs3KeySourceChanged"/>
                                    <RadioButton x:Name="RdoWritePs3DkeyFile" Content=".dkey 文件"
                                                 Foreground="#E8F0FE"
                                                 GroupName="WritePs3KeySource"
                                                 IsCheckedChanged="OnWritePs3KeySourceChanged"/>
                                    <RadioButton x:Name="RdoWritePs3HexKey" Content="十六进制密钥"
                                                 Foreground="#E8F0FE"
                                                 GroupName="WritePs3KeySource"
                                                 IsCheckedChanged="OnWritePs3KeySourceChanged"/>
                                </StackPanel>

                                <!-- IRD / dkey file browse -->
                                <Grid x:Name="PnlWritePs3FileBrowse" ColumnDefinitions="*,Auto">
                                    <TextBox x:Name="TxtWritePs3KeyFilePath" Grid.Column="0"
                                             Watermark="选择 IRD 或 .dkey 文件…"
                                             Foreground="#E8F0FE" FontSize="12"
                                             IsReadOnly="True"/>
                                    <Button Content="浏览…" Classes="ActionBtn"
                                            Grid.Column="1" Margin="6,0,0,0"
                                            Click="OnBrowseWritePs3KeyFileClick"/>
                                </Grid>

                                <!-- Hex key input -->
                                <TextBox x:Name="TxtWritePs3HexKey" IsVisible="False"
                                         Watermark="输入 32 位十六进制光盘密钥…"
                                         Foreground="#E8F0FE" FontSize="12"
                                         MaxLength="32"/>

                                <TextBlock x:Name="TxtWritePs3KeyStatus" Text=""
                                           Foreground="#5A7A9A" FontSize="10" TextWrapping="Wrap"/>

                                <CheckBox x:Name="ChkWritePs3Decrypt"
                                          Content="刻录前解密 ISO 镜像"
                                          IsChecked="True" Foreground="#E8F0FE"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Build on-the-fly mode panel -->
                    <StackPanel x:Name="PnlOnTheFly" Spacing="10" IsVisible="False">
                        <!-- Source folder -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="源文件夹：" Classes="FieldLabel"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox x:Name="TxtOtfSourceFolder"
                                         Watermark="选择包含待刻录文件的文件夹…"
                                         Background="#152030" Foreground="#E8F0FE"
                                         ToolTip.Tip="将其内容刻录到光盘的根文件夹。包含所有文件和子目录。"
                                         DragDrop.AllowDrop="True"
                                         DragDrop.DragOver="OnFolderDragOver"
                                         DragDrop.Drop="OnFolderDrop"/>
                                <Button x:Name="BtnOtfBrowseFolder" Grid.Column="1"
                                        Content="浏览…" Classes="ActionBtn"
                                        Margin="6,0,0,0" Click="OnOtfBrowseFolderClick"
                                        ToolTip.Tip="浏览并选择源文件夹"/>
                            </Grid>
                        </StackPanel>

                        <!-- Individual files/folders list -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="或添加单个文件和文件夹：" Classes="FieldLabel"/>
                            <Border Background="#0A1520" CornerRadius="6" Padding="6" MinHeight="80"
                                    DragDrop.AllowDrop="True"
                                    DragDrop.DragOver="OnFilesDragOver"
                                    DragDrop.Drop="OnFilesDrop">
                                <StackPanel>
                                    <ListBox x:Name="LstOtfFiles"
                                             Background="Transparent" Foreground="#E8F0FE"
                                             MaxHeight="160"
                                             ToolTip.Tip="要包含在光盘中的文件和文件夹。可将文件拖放到此处，或使用“添加”按钮。"/>
                                    <TextBlock x:Name="TxtOtfFilesHint"
                                               Text="💡 将文件或文件夹拖放到此处"
                                               Foreground="#5A7A9A" FontSize="10"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                <Button x:Name="BtnOtfAddFiles" Content="＋ 添加文件"
                                        Classes="ActionBtn" Click="OnOtfAddFilesClick"
                                        ToolTip.Tip="向光盘添加单个文件"/>
                                <Button x:Name="BtnOtfAddFolder" Content="📁 添加文件夹"
                                        Classes="ActionBtn" Click="OnOtfAddFolderClick"
                                        ToolTip.Tip="将文件夹及其全部内容添加到光盘"/>
                                <Button x:Name="BtnOtfRemove" Content="✕ 移除"
                                        Classes="ActionBtn" Click="OnOtfRemoveClick"
                                        ToolTip.Tip="从列表中移除选中项"/>
                                <Button x:Name="BtnOtfClearAll" Content="🧹 全部清除"
                                        Classes="ActionBtn" Click="OnOtfClearAllClick"
                                        ToolTip.Tip="从列表中移除所有项"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Disc settings for on-the-fly -->
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto">
                            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                <TextBlock Text="卷标：" Classes="FieldLabel"/>
                                <TextBox x:Name="TxtOtfVolumeLabel"
                                         Watermark="MY_DISC"
                                         Background="#152030" Foreground="#E8F0FE"
                                         MaxLength="32"
                                         ToolTip.Tip="光盘卷标（ISO 9660 最多 32 个字符）"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="文件系统：" Classes="FieldLabel"/>
                                <ComboBox x:Name="CmbOtfFileSystem" HorizontalAlignment="Stretch"
                                          ToolTip.Tip="光盘镜像的文件系统格式。Joliet 提供长文件名和 Unicode 支持。大文件（&gt;4 GB）和蓝光需要 UDF。"/>
                            </StackPanel>
                        </Grid>

                        <!-- Source info -->
                        <TextBlock x:Name="TxtOtfInfo" Text="" Foreground="#5A7A9A" FontSize="10" Margin="0,2,0,0"/>
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- Detected Content (auto-populated from image analysis) -->
            <Border x:Name="PnlWriteDetectedContent" Classes="Card" IsVisible="False">
                <StackPanel Spacing="6">
                    <TextBlock Text="🔍  检测到的内容" Classes="SectionHeader"/>
                    <TextBlock x:Name="TxtWriteDetectedContent" Text="—" Foreground="#E8F0FE"
                               FontSize="14" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtWriteDetectedPreset" Text=""
                               Foreground="#5A7A9A" FontSize="11" FontStyle="Italic"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Target Drive & Write Settings -->
            <Border Classes="Card">
                <StackPanel Spacing="12">
                    <TextBlock Text="目标光驱与写入设置" Classes="SectionHeader"/>

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                            <TextBlock Text="光驱：" Classes="FieldLabel"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <ComboBox x:Name="CmbDrive" HorizontalAlignment="Stretch"
                                          PlaceholderText="选择刻录机…"
                                          ToolTip.Tip="选择要刻录到的光驱"/>
                                <Button x:Name="BtnRefreshDrives" Grid.Column="1"
                                        Content="🔄" Classes="ActionBtn"
                                        Margin="6,0,0,0" Click="OnRefreshDrivesClick"
                                        ToolTip.Tip="刷新可用光驱列表"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                            <TextBlock Text="写入速度：" Classes="FieldLabel"/>
                            <ComboBox x:Name="CmbSpeed" HorizontalAlignment="Stretch"
                                      ToolTip.Tip="写入速度 — 较低速度可获得更可靠的刻录质量"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4" Margin="0,8,8,0">
                            <TextBlock Text="写入模式：" Classes="FieldLabel"/>
                            <ComboBox x:Name="CmbWriteMode" HorizontalAlignment="Stretch"
                                      ToolTip.Tip="DAO 一次性写入整张光盘；TAO 逐个轨道写入"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4" Margin="0,8,0,0">
                            <TextBlock Text="份数：" Classes="FieldLabel"/>
                            <NumericUpDown x:Name="NumCopies" Minimum="1" Maximum="99" Value="1"
                                           Background="#152030" Foreground="#E8F0FE"
                                           ToolTip.Tip="要刻录的份数"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Burn Options -->
            <Border Classes="Card">
                <StackPanel Spacing="8">
                    <TextBlock Text="刻录选项" Classes="SectionHeader"/>
                    <Grid ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Spacing="6">
                            <CheckBox x:Name="ChkEject" Content="刻录后弹出"
                                      IsChecked="True" Foreground="#E8F0FE"
                                      ToolTip.Tip="刻录完成后自动弹出光盘托盘"/>
                            <CheckBox x:Name="ChkShowDiscContent" Content="刻录后显示光盘内容"
                                      Foreground="#E8F0FE"
                                      ToolTip.Tip="刻录成功完成后打开文件资源管理器显示光盘内容"/>
                            <CheckBox x:Name="ChkVerify" Content="刻录后校验"
                                      Foreground="#E8F0FE"
                                      ToolTip.Tip="刻录后回读并校验数据"/>
                            <CheckBox x:Name="ChkSimulate" Content="模拟 / 测试写入"
                                      Foreground="#E8F0FE"
                                      ToolTip.Tip="执行测试刻录而不写入任何数据"/>
                            <CheckBox x:Name="ChkBurnProof" Content="缓存欠载保护"
                                      IsChecked="True" Foreground="#E8F0FE"
                                      ToolTip.Tip="防止刻录过程中出现缓存欠载错误"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <CheckBox x:Name="ChkClose" Content="关闭 / 封盘"
                                      IsChecked="True" Foreground="#E8F0FE"
                                      ToolTip.Tip="封盘（独立播放机播放所必需）"/>
                            <CheckBox x:Name="ChkOverburn" Content="超刻"
                                      Foreground="#E8F0FE"
                                      ToolTip.Tip="写入超过光盘标称容量（有风险）"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="超刻上限（MB）：" Foreground="#5A7A9A"
                                           FontSize="11" VerticalAlignment="Center"/>
                                <NumericUpDown x:Name="NumOverburnMB"
                                               Minimum="0" Maximum="100" Value="0"
                                               Width="80" IsEnabled="False"
                                               Background="#152030" Foreground="#E8F0FE"
                                               ToolTip.Tip="超出标称容量的额外 MB 数"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Multi-session -->
            <Border Classes="Card">
                <StackPanel Spacing="8">
                    <TextBlock Text="多区段" Classes="SectionHeader"/>
                    <ComboBox x:Name="CmbMultiSession" HorizontalAlignment="Stretch"
                              ToolTip.Tip="单区段会关闭光盘；多区段允许日后追加更多数据">
                        <ComboBoxItem Content="Close (Single Session)"/>
                        <ComboBoxItem Content="Start (Multi-session)"/>
                        <ComboBoxItem Content="Continue (Append session)"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Advanced Options -->
            <Expander Header="⚙️  高级选项" Classes="SettingsExpander">
                <StackPanel Spacing="10" Margin="0,8,0,0">
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                            <TextBlock Text="强制介质类型：" Classes="FieldLabel"/>
                            <TextBox x:Name="TxtForceMediaType" Background="#152030"
                                     Foreground="#E8F0FE"
                                     Watermark="例如 CD-R、DVD+R（可选）"
                                     ToolTip.Tip="覆盖自动介质类型检测"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                            <TextBlock Text="BD-R 模式：" Classes="FieldLabel"/>
                            <ComboBox x:Name="CmbBdRMode" HorizontalAlignment="Stretch"
                                      ToolTip.Tip="蓝光记录模式">
                                <ComboBoxItem Content="SRM (Sequential Recording)"/>
                                <ComboBoxItem Content="SRM+POW"/>
                                <ComboBoxItem Content="RRM (Random Recording)"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4" Margin="0,8,8,0">
                            <TextBlock Text="DVD 换层点：" Classes="FieldLabel"/>
                            <NumericUpDown x:Name="NumLayerBreak"
                                           Minimum="0" Maximum="999999" Value="0"
                                           Background="#152030" Foreground="#E8F0FE"
                                           ToolTip.Tip="双层 DVD 的换层位置"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Expander>

            <!-- Gaming Patches -->
            <Expander Header="🎮  游戏补丁与特殊格式" Classes="SettingsExpander">
                <StackPanel Spacing="8" Margin="0,8,0,0">
                    <CheckBox x:Name="ChkLibCrypt"
                              Content="应用 LibCrypt 保护（PS1 SBI 文件）"
                              Foreground="#E8F0FE"
                              ToolTip.Tip="为 PlayStation 1 游戏启用 LibCrypt 防复制补丁"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox x:Name="TxtSbiPath"
                                 Watermark="LibCrypt .sbi 文件路径…"
                                 Background="#152030" Foreground="#E8F0FE" IsEnabled="False"
                                 ToolTip.Tip="用于 PS1 游戏保护的 LibCrypt .sbi 文件路径"
                                 DragDrop.AllowDrop="True"
                                 DragDrop.DragOver="OnImageDragOver"
                                 DragDrop.Drop="OnSbiDrop"/>
                        <Button x:Name="BtnBrowseSbi" Grid.Column="1"
                                Content="浏览…" Classes="ActionBtn"
                                Margin="6,0,0,0" IsEnabled="False"
                                Click="OnBrowseSbiClick"
                                ToolTip.Tip="浏览并选择 LibCrypt .sbi 文件"/>
                    </Grid>
                    <CheckBox x:Name="ChkDcGdi"
                              Content="Sega Dreamcast GDI/CDI 补丁"
                              Foreground="#E8F0FE"
                              ToolTip.Tip="为 Sega Dreamcast 光盘镜像应用 GDI/CDI 补丁"/>
                    <CheckBox x:Name="ChkRegionFree"
                              Content="全区补丁"
                              Foreground="#E8F0FE"
                              ToolTip.Tip="移除光盘镜像的区域限制"/>
                    <CheckBox x:Name="ChkBootPatch"
                              Content="引导扇区补丁"
                              Foreground="#E8F0FE"
                              ToolTip.Tip="修补引导扇区以兼容修改版固件"/>
                    <CheckBox x:Name="ChkEsrPatch"
                              Content="ESR 补丁（PS2 DVD-R）"
                              Foreground="#E8F0FE"
                              ToolTip.Tip="注入 DVD-Video UDF 结构，以便在 DVD-R 介质上绕过 PS2 MechaCon"/>
                    <CheckBox x:Name="ChkMasterDiscPatch"
                              Content="Master Disc 补丁（PS2）"
                              Foreground="#E8F0FE"
                              ToolTip.Tip="为 MechaPwn DEX PS2 主机应用 Master Disc 补丁"/>
                    <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding #ChkMasterDiscPatch.IsChecked}">
                        <TextBlock Text="区域：" Foreground="#8EAFC8" FontSize="12"
                                   VerticalAlignment="Center" Margin="24,0,8,0"/>
                        <ComboBox x:Name="CmbMasterDiscRegion" Grid.Column="1"
                                  Background="#152030" Foreground="#E8F0FE"
                                  SelectedIndex="1"
                                  ToolTip.Tip="Master Disc 补丁的区域">
                            <ComboBoxItem Content="NTSC-J" Tag="NTSC-J"/>
                            <ComboBoxItem Content="NTSC-U" Tag="NTSC-U"/>
                            <ComboBoxItem Content="PAL" Tag="PAL"/>
                            <ComboBoxItem Content="WORLD" Tag="WORLD"/>
                        </ComboBox>
                    </Grid>
                    <CheckBox x:Name="ChkPsx80Min"
                              Content="PSX 80 分钟补丁（PS1/PS2 CD-R）"
                              Foreground="#E8F0FE"
                              ToolTip.Tip="追加虚拟扇区以兼容 80 分钟 CD-R"/>
                    <CheckBox x:Name="ChkPsxUndither"
                              Content="PSX 去抖动补丁（PS1）"
                              Foreground="#E8F0FE"
                              ToolTip.Tip="移除 PS1 游戏镜像中的 GPU 抖动图案"/>
                    <TextBlock Text="⚠️ 游戏补丁仅可用于合法拥有的软件。"
                               Foreground="#FF8C00" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
            </Expander>

            <!-- Progress & Log -->
            <Border Classes="Card">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Text="刻录进度" Classes="SectionHeader"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="BtnBurn" Grid.Column="1"
                                Content="🔥  刻录" Classes="PrimaryBtn"
                                Margin="0,0,8,0" Click="OnBurnClick"
                                ToolTip.Tip="开始将镜像刻录到光盘"/>
                        <Button x:Name="BtnCancel" Grid.Column="2"
                                Content="⏹  取消" Classes="DangerBtn"
                                IsEnabled="False" Click="OnCancelClick"
                                ToolTip.Tip="取消刻录操作"/>
                    </Grid>

                    <ProgressBar x:Name="BurnProgressBar" Classes="BurnProgress" Value="0"/>

                    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                        <TextBlock x:Name="TxtBurnStatus" Text="就绪。"
                                   Foreground="#5A7A9A" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtCurrentSpeed" Grid.Column="1"
                                   Text="" Foreground="#1E90FF" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock x:Name="TxtETA" Grid.Column="2"
                                   Text="" Foreground="#5A7A9A" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock x:Name="TxtBurnPct" Grid.Column="3"
                                   Text="0%" Foreground="#E8F0FE" FontSize="11"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Disc Visualization -->
                    <Border x:Name="DiscVizBorder" Background="#0A1520" CornerRadius="8"
                            Padding="8" IsVisible="False"
                            ToolTip.Tip="实时刻录可视化 — 显示光盘物理螺旋上的 LBA 位置">
                        <views:DiscVisualizationControl x:Name="DiscViz" Height="200"/>
                    </Border>

                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Text="日志" Classes="SectionHeader" VerticalAlignment="Center"/>
                        <Button x:Name="BtnClearLog" Grid.Column="1"
                                Content="🧹 清除" Classes="ActionBtn"
                                HorizontalAlignment="Right" Click="OnClearLogClick"
                                ToolTip.Tip="清除日志输出"/>
                    </Grid>

                    <TextBox x:Name="TxtLog" Classes="LogBox" Height="180"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
